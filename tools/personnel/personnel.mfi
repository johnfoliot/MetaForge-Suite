<!-- --- START OF FILE personnel.mfi --- -->
<h1 class="main" tabindex="-1">Personnel Scout</h1>
<p class="tool_notes"><!--
    Automatically resolves album/track credits from <span style="font-weight:bold; color:var(--mf-gold);">MusicBrainz + Discogs</span>, falling back to AI Web Search when thin (its own grounded search already sweeps up Wikipedia/AllMusic/independent sources), with manual Wikipedia search and AllMusic paste both always available for your own follow-up.
    Review and edit the staged mapping before committing to the MetaForge relationship graph. -->
</p>

<div id="mfi-content" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">


    <div id="p-loading-overlay" class="p-overlay" role="status" aria-live="polite" style="display: none;">
        <div style="font-size:.85rem; color:#fff; margin-left:50%; max-width:35%;">
            <div class="p-spinner"></div>
            <img src="\ui\images\intelligence.png" alt="" style="height:36px; width:auto; float:left; margin-right:10px;">
            <p id="p-loading-text">Resolving personnel via MusicBrainz + Discogs...</p>
        </div>
    </div>

    <!-- MAIN WORKING STAGE: SIDE-BY-SIDE SILOS -->
    <div id="p-workspace-stage" style="flex: 1; display: flex; gap: 15px; padding: 10px; overflow: hidden; background: var(--bg-main);">
        
        <!-- LEFT SILO: THE RADAR & SOURCE (40% Width) -->
        <div id="p-left-silo" style="flex: 0 0 42%; display: flex; flex-direction: column; gap: 10px; min-height: 0; border-right: 1px solid #444; padding-right: 15px;">
            
            <!-- SOURCE DIRECTORY BLOCK -->
            <div style="display: grid; grid-template-columns: 100px 1fr 80px; gap: 8px; align-items: center;">
                <label for="p-local-path" class="mf-card-label" style="text-align: right; color: var(--mf-gold);">Source Directory:</label>
                <input type="text" id="p-local-path" class="mb-input-text" placeholder="Select album folder..." 
                       style="background: var(--input-background2); color: var(--input-foreground2);">
                <button class="mf-button-gold-fixed" onclick="window.metaforge.personnel.selectFolder()">Browse</button>
            </div>

            <hr style="border: 0; border-top: 1px solid #333; margin: 5px 0;">

            <!-- IDENTITY CONTEXT BLOCK -->
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: grid; grid-template-columns: 100px 1fr; gap: 10px; align-items: center;">
                    <label for="p-artist-input" class="mf-card-label" style="text-align: right; color: var(--mf-gold);">Artist:</label>
                    <input type="text" id="p-artist-input" class="mb-input-text" style="background: var(--input-background2); color: var(--input-foreground2);">
                    
                    <label for="p-album-input" class="mf-card-label" style="text-align: right; color: var(--mf-gold);">Album:</label>
                    <input type="text" id="p-album-input" class="mb-input-text" style="background: var(--input-background2); color: var(--input-foreground2);">
                </div>
                
                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px;">
                    <label for="p-year-input" class="mf-card-label" style="color: var(--mf-gold);">Year:</label>
                    <input type="text" id="p-year-input" class="mb-input-text" style="width: 60px; text-align: center; background: var(--input-background2); color: var(--input-foreground2);">
                </div>
            </div>

            <!-- STATUS: relocated here 2026-07-09 (John) -- was a thin
                 bar at the very bottom of the whole page, far from these
                 action controls. At high screen magnification (200%+),
                 that distance means physically panning the viewport to
                 find out whether anything happened at all, not just an
                 inconvenience for a low-vision user -- proximity of
                 feedback to its trigger is the actual requirement here,
                 not a cosmetic preference.

                 REDESIGNED 2026-08-13 (John): the plain text-only status
                 line wasn't prominent enough given how much it actually
                 conveys. Now a two-part panel: the headline text stays
                 (same aria-live region, same #p-status-text id -- no JS
                 wiring changed there), plus a real 2x2 per-source grid
                 below it. MusicBrainz/Discogs are automatic (checked the
                 instant resolveWaterfall() completes, no button needed);
                 Wikipedia/AllMusic keep their existing search buttons,
                 which get replaced in place by the same green checkmark
                 once that source has genuinely been checked (regardless
                 of whether it found anything -- John's explicit rule).
                 Checkmarks are a static "done for this session" badge,
                 not clickable to re-run (John's call, 2026-08-13). -->
            <div id="p-status-bar" role="status" aria-live="polite" class="p-scout-panel">
                <div id="p-status-text" class="p-scout-headline" style="color: var(--status-success);">Scout Engine Ready.</div>
                <div class="p-scout-grid">
                    <div class="p-scout-source">
                        <img src="/ui/images/musicbrainz.svg" alt="" class="p-scout-logo" style="margin-left:27px; margin-right:27px;">
                        <!-- class/content/aria-label all set dynamically by
                             personnel.js's _markSourceChecked() -- distinct
                             "found" (green check) vs "none" (red circle-
                             slash) states, not just a static checkmark. -->
                        <span id="p-src-mb-check" class="p-scout-check"></span>
                    </div>
                    <div class="p-scout-source">
                        <img src="/ui/images/wikipedia.png" alt="" class="p-scout-logo">
                        <button id="p-src-wiki-btn" class="mf-button-gold-fixed p-scout-btn" onclick="window.metaforge.personnel.searchWikipedia()" title="Wikipedia doesn't offer structed data queries - this requires some manual intervention.">Search Wikipedia&nbsp;</button>
                        <span id="p-src-wiki-check" class="p-scout-check"></span>
                    </div>
                    <div class="p-scout-source">
                        <img src="/ui/images/Discogs_logo.png" alt="" class="p-scout-logo">
                        <span id="p-src-discogs-check" class="p-scout-check"></span>
                    </div>
                    <div class="p-scout-source">
                        <img src="/ui/images/AllMusic.png" alt="" class="p-scout-logo">
                        <button id="p-src-allmusic-btn" class="mf-button-gold-fixed p-scout-btn"
                                onclick="window.metaforge.personnel.checkAllMusic()" title="Last resort: opens an AllMusic search in a companion tab -- you copy the credits table yourself, MetaForge never fetches AllMusic directly.">&nbsp;Search AllMusic&nbsp;</button>
                        <span id="p-src-allmusic-check" class="p-scout-check"></span>
                    </div>
                </div>
            </div>

            <!-- CANDIDATE TABLE: FIXED HEIGHT (Directive: UI Stability) -->
            <div style="height: 155px; flex-shrink: 0; display: flex;">
                <div id="p-search-results-container" class="mf-hide-native-scrollbar" style="flex: 1; border: 1px solid var(--mf-gold); border-right: none; background: var(--bg-accent); overflow-y: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.75rem;">
                        <thead style="position: sticky; top: 0; background: var(--bg-main); color: var(--mf-gold); border-bottom: 1px solid var(--mf-gold);">
                            <tr>
                                <th style="padding: 4px; text-align: left;">Wikipedia Candidate</th>
                                <th style="padding: 4px; text-align: right; width: 60px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="p-search-results-body">
                            <tr><td colspan="2" style="padding: 10px; text-align: center; opacity: 0.5;">Identity results will appear here.</td></tr>
                        </tbody>
                    </table>
                </div>
                <!-- Custom scrollbar, shared implementation -- see
                     layout.css section 10 / metaforge_core.js's
                     MFScrollbar. No per-tool JS needed. Note: this pane
                     is only 155px tall total -- worth watching whether
                     two 40px buttons feel cramped here specifically,
                     same open sizing question flagged for the Album
                     Personnel scrollbar. -->
                <div class="mf-custom-scrollbar" role="scrollbar" aria-controls="p-search-results-container" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                    <div class="mf-scroll-track">
                        <div class="mf-scroll-thumb"></div>
                    </div>
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
                </div>
            </div>

        </div>

        <!-- RIGHT SILO: MAPPING INTERFACE (60% Width) -->
        <div id="p-right-silo" style="flex: 1; display: flex; flex-direction: column; gap: 10px; min-height: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--mf-gold); padding-bottom: 5px;">
                <h2 class="mf-card-label" style="color: var(--mf-gold); margin: 0;"><img src="ui/images/personnel.svg"alt=""style="height:32px; width:auto;"> Album Artists</h2>
                <span id="p-mapping-count" class="mf-card-label" style="font-size: 0.75rem; color: var(--text-message);">0 Rows Staged</span>
            </div>

            <div id="p-mapping-outer" style="flex: 1; display: flex; min-height: 0;">
                <div id="p-mapping-viewport" class="mf-hide-native-scrollbar" style="flex: 1; overflow-y: auto; background: var(--bg-stage); border: 1px solid #000; border-right: none;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.8rem;">
                        <thead style="background: var(--bg-stage); position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--mf-gold);">
    						<tr>
    							<th style="padding: 8px; text-align: left; color: var(--mf-gold); width: 45%; cursor: pointer;"
    								onclick="window.metaforge.personnel.sortMapping('name')">Name ↕</th>
    							<th style="padding: 8px; text-align: left; color: var(--mf-gold); width: 45%; cursor: pointer;"
    								onclick="window.metaforge.personnel.sortMapping('role')">Role ↕</th>
    							<th style="padding: 8px; text-align: center; width: 40px;">X</th>
    						</tr>
    					</thead>
                        <tbody id="p-mapping-body" style="color: var(--text-output);">
                            <!-- Mapping rows injected via JS -->
                        </tbody>
                    </table>
                </div>
                <!-- Custom scrollbar, shared implementation (John's report,
                     2026-08-11) -- see layout.css section 10 and
                     metaforge_core.js's MFScrollbar for the full history
                     and the shared CSS/JS. No per-tool JS needed: found
                     and wired automatically by
                     MFScrollbar.autoAttachAll(), called from
                     initCommonComponents() on every tool load. -->
                <div class="mf-custom-scrollbar" role="scrollbar" aria-controls="p-mapping-viewport" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                    <div class="mf-scroll-track">
                        <div class="mf-scroll-thumb"></div>
                    </div>
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; padding-top: 10px; background: var(--bg-main);">
                 <button class="mf-button-gold-fixed" style="background: transparent!important; border: 1px solid var(--mf-gold); color: var(--mf-gold)!important;" onclick="window.metaforge.personnel.addManualRow()">Add Manual Entry</button>
                 <!-- Expand Commit Button width to fit text -->
                 <button id="p-commit-btn" class="mf-button-gold-fixed" style="width: 240px; height: 40px; font-size: 1rem; opacity: 0.5;" disabled onclick="window.metaforge.personnel.commitToDatabase()">Commit to Database</button>
            </div>
        </div>
    </div>
</div>

<style>
/* Source-status panel, replacing the old plain text-only status bar
   (John, 2026-08-13 -- "the advisory area is not prominent enough"). */
.p-scout-panel {
    border: 1px solid var(--mf-gold);
    background: var(--bg-accent);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.p-scout-headline {
    font-size: 0.95rem;
    font-weight: bold;
    line-height: 1.3;
}
.p-scout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 20px;
}
.p-scout-source {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
}
.p-scout-logo {
    height: 32px;
    width: auto;
    max-width: 92px;
    object-fit: contain;
    flex-shrink: 0;
}
.p-scout-btn {
    font-size: 0.72rem !important;
    padding: 4px 8px !important;
}
/* Badge replaces the button in place once a source has genuinely been
   checked. Static, not clickable (John's call, 2026-08-13). Hidden by
   default; personnel.js's _markSourceChecked(key, found) reveals it,
   hides the sibling button, and picks one of two states below --
   John's report, same day: a flat checkmark for every outcome made a
   source that contributed nothing look identical to one that actually
   helped (a real "60 credits found via MusicBrainz" case where Discogs
   silently contributed zero, but both showed the same green check).
   .p-scout-found (green check, rounded square) = this source
   contributed real credits/candidates. .p-scout-none (red circle-slash)
   = checked, found nothing -- a genuinely different SHAPE and color,
   not just a number next to the same icon, so the distinction survives
   even for a user not reading the shape closely. Drawn in pure CSS
   (border-radius + a rotated bar), not a Unicode/emoji glyph -- glyph
   rendering proved unreliable across this exact codebase's scrollbar
   work, a plain geometric shape has no such risk. */
.p-scout-check {
    display: none;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    position: relative;
}
.p-scout-check.p-scout-found {
    border-radius: 4px;
    background: var(--status-success);
    color: #fff;
    font-weight: bold;
    font-size: 0.9rem;
}
.p-scout-check.p-scout-none {
    border-radius: 50%;
    background: var(--status-error);
}
.p-scout-check.p-scout-none::before {
    content: "";
    position: absolute;
    width: 65%;
    height: 2px;
    background: #fff;
    transform: rotate(-45deg);
}

/* Same pattern as tools/biography/biography.mfi's .bio-overlay/.bio-spinner
   (John, 2026-07-09) -- reused deliberately, not reinvented. */
.p-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--bg-stage) 50%, transparent);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: var(--mf-gold);
    font-family: 'Cascadia Code', monospace;
}
.p-spinner { width: 40px; height: 40px; border: 4px solid #333; border-top: 4px solid var(--mf-gold); border-radius: 50%; animation: p-spin 1s linear infinite; margin-bottom: 10px; margin-left: 150px; }
@keyframes p-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* Custom scrollbar CSS (.mf-custom-scrollbar etc.) now lives shared in
   layout.css section 10, not duplicated per-tool here -- see that file
   for the full history of why native ::-webkit-scrollbar-button was
   abandoned. #p-mapping-viewport's own markup carries
   .mf-hide-native-scrollbar to suppress its real native scrollbar. */
</style>

<script>
    if (window.metaforge && window.metaforge.personnel) {
        window.metaforge.personnel.init();
    }
</script>
<!-- --- END OF FILE personnel.mfi --- -->