<!-- --- START OF FILE musicbrainz_id.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: MusicBrainz IDs (Structural Sync Build)
     Build 2.20.4: Corrected Action Row Layout & Enabled Handshake Scrolling.
     Accessibility: WCAG 2.2 AA | COGA 4.5.4 (Error Prevention)
     ============================================================ -->
<style>
    /* --- LOCALIZED WORKBENCH SKIN --- */
    .mb-split-stage {
        display: flex;
        width: 100%;
        height: 100%;
        min-height: 0;
        gap: 20px;
    }

    /* Silo 1: Discovery (40% Fixed) */
    .mb-discovery-silo {
        flex: 0 0 calc(40% - 10px);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
        min-width: 0;
    }

    /* Silo 2: Structural Alignment (60% Fixed) */
    .mb-confirm-silo {
        flex: 0 0 calc(60% - 10px);
        display: flex;
        flex-direction: column;
        background-color: var(--bg-main);
        border: 1px solid var(--mf-gold);
        padding: 15px;
        min-width: 0;
    }

    .mb-input-panel {
        background: var(--bg-main);
        padding: 15px;
        border: 1px solid var(--bg-accent);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
    }

    .mb-field-row {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .mb-label {
        color: var(--mf-gold);
        font-weight: bold;
        font-size: 0.85rem;
        width: 80px;
        flex-shrink: 0;
    }

    .mb-input-text {
        background-color: var(--input-background2);
        color: var(--input-foreground);
        border: 1px solid #000000;
        padding: 6px 10px;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        flex: 1;
        min-width: 0;
    }

    /* Requirement: Status message horizontally aligned to the right of button */
    .mb-action-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 15px;
        width: 100%;
        margin-top: 5px;
    }

    #mb-status-announcer {
        font-size: 0.85rem;
        font-weight: bold;
        font-family: var(--font-main);
        white-space: nowrap;
        flex: 1;
    }

    .status-success { color: var(--status-success) !important; }
    .status-error { color: var(--status-error) !important; }

    .mb-results-viewport {
        width: 100%;
        flex: 1;
        background: var(--bg-main);
        border: 1px solid var(--bg-accent);
        overflow-y: auto;
        min-height: 0;
    }

    .mb-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.7rem;
    }

    .mb-table th {
        position: sticky;
        top: 0;
        background: var(--bg-accent);
        color: var(--mf-gold);
        text-align: left;
        padding: 6px 8px;
        border-bottom: 1px solid var(--mf-gold);
        z-index: 2;
    }

    .mb-table td {
        padding: 6px 8px;
        border-bottom: 1px solid var(--bg-accent);
        color: var(--text-message);
        cursor: pointer;
    }

    /* --- THE VISUAL HANDSHAKE GRID (Sync Scroll) --- */
    .mb-alignment-headers {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 5px;
    }

    .mb-list-header {
        font-size: 0.65rem;
        font-weight: bold;
        padding: 6px;
        background: var(--bg-accent);
        color: var(--mf-gold);
        border-bottom: 1px solid var(--mf-gold);
    }

    /* Requirement: Comparison Viewport must be scrollable */
    .mb-comparison-viewport {
        flex: 1;
        overflow-y: auto;
        border: 1px solid var(--bg-accent);
        background: var(--bg-main);
        min-height: 0;
        padding-right: 4px;
    }

    /* Fixed Row Height for Handshake Alignment (Requirement IV.2) */
    .mb-handshake-row {
        height: 32px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        border-bottom: 1px solid #222;
        align-items: center;
    }

    .mb-handshake-row:nth-child(even) { background: rgba(255,255,255,0.02); }

    .mb-col {
        display: flex;
        align-items: center;
        padding: 0 8px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        gap: 8px;
        overflow: hidden;
    }

    .mb-track-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    /* Sorting Widgets (Requirement IV.2) */
    .mb-sort-ctrls {
        display: flex;
        gap: 2px;
        flex-shrink: 0;
    }

    .mb-btn-sort {
        background: var(--bg-accent);
        color: var(--mf-gold);
        border: 1px solid var(--mf-gold);
        padding: 0 4px;
        font-size: 0.6rem;
        cursor: pointer;
        height: 20px;
        width: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mb-btn-sort:hover { background: var(--mf-gold); color: var(--input-foreground); }
    .mb-btn-sort:disabled { opacity: 0.2; cursor: default; }

    .mb-confirm-footer {
        margin-top: 15px;
        padding-top: 10px;
        border-top: 1px solid var(--bg-accent);
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 45px;
    }

    #mb-handoff-container {
        display: flex;
        justify-content: flex-end;
        min-width: 150px;
    }
</style>

<h1 id="mb-id-header" class="main" tabindex="-1">MusicBrainz IDs</h1>

<section class="musicbrainz-description" aria-labelledby="musicbrainz-info-label">
    <h2 id="musicbrainz-info-label" class="mf-grid-heading" style="display:none;">Tool Description</h2>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
		<p class="data-text tool_notes">MusicBrainz can be a goldmine of information, but it can be a messy pool of data. 
            Align your local files with the official tracklist to ensure forensic accuracy.</p>
        <button class="mf-button-gold-fixed" 
                style="font-size:80%;margin-left:1.5rem; margin-right: 5rem;"
                onclick="metaforge.musicbrainz_id.openHelp()"  
                aria-label="Open MusicBrainz IDs help documentation">
            Help
        </button>
    </div>
</section>





<div class="active_stage">
    <div class="mb-split-stage">
        
        <!-- SILO 1: DISCOVERY -->
        <div class="mb-discovery-silo">
            <div class="status-api" style="font-size:1rem; color:var(--mf-gold); padding:5px 0;">
                <img src="/ui/images/musicbrainz.svg" style="height:16px; vertical-align:middle;" alt=""> Getting MusicBrainz Ids
            </div>
            <div class="mb-input-panel">
                <div class="mb-field-row">
                    <label for="mb-local-path" class="mb-label">Local Source</label>
                    <input type="text" id="mb-local-path" class="mb-input-text" style="color:var(--input-foreground2);" readonly style="background:var(--bg-accent); color:var(--text-message);">
                    <button class="mf-button-gold-fixed" onclick="metaforge.musicbrainz_id.selectFolder()">Browse</button>
                </div>
                <div class="mb-field-row">
                    <label for="mb-album-input" class="mb-label">Album</label>
                    <input type="text" id="mb-album-input" class="mb-input-text" style="color:var(--input-foreground2);" placeholder="Album Title">
                </div>
                <div class="mb-field-row">
                    <label for="mb-artist-input" class="mb-label">Artist</label>
                    <input type="text" id="mb-artist-input" class="mb-input-text" style="color:var(--input-foreground2);" placeholder="Artist Name" style="width:50px;">
                    <label for="mb-local-track-count" class="mb-label" style="width:auto; margin-left:10px;">Tracks</label>
                    <input type="text" id="mb-local-track-count" class="mb-input-text" style="width:20px!important; text-align:center; color:var(--input-foreground2);" readonly value="--">
                </div>
                <div class="mb-action-row">
                    <button onclick="metaforge.musicbrainz_id.search()">Search <br>MusicBrainz</button>
                    <div id="mb-status-announcer" aria-live="polite"></div>
                </div>
            </div>

            <div class="mb-results-viewport">
                <table class="mb-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">Score</th>
                            <th>Artist / Album</th>
                            <th style="width:40px;">Tracks</th>
                            <th style="width:40px;">Year</th>
                            <th style="width:45px; text-align:center;">CC</th>
                        </tr>
                    </thead>
                    <tbody id="mb-results-body">
                        <tr><td colspan="5" class="tool_notes" style="padding:20px;">Ready for Discovery.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SILO 2: ALIGNMENT & SYNC -->
        <div class="mb-confirm-silo">
            <h2 class="mf-grid-heading" style="border-bottom:1px solid var(--mf-gold); padding-bottom:5px; margin-bottom:10px; font-size:1rem;">Confirm Choice</h2>
            <div id="mb-id-summary" style="font-family:var(--font-mono); font-size:0.6rem; color:var(--mf-gold); min-height:35px; margin-bottom:5px;">
                Select a Release to view the MusicBrainz IDs
            </div>

            <div class="mb-alignment-headers">
                <div class="mb-list-header">Local Album Data:</div>
                <div class="mb-list-header">MusicBrainz Data:</div>
            </div>

            <div id="mb-comparison-viewport" class="mb-comparison-viewport">
                <!-- Rows injected dynamically by JS bridge -->
            </div>

            <div class="mb-confirm-footer">
                <button id="mb-commit-btn" class="mf-button-gold-fixed" onclick="metaforge.musicbrainz_id.commit()" disabled style="opacity:0.5;">
                    Commit IDs to Files
                </button>
                <div id="mb-handoff-container"></div>
            </div>
        </div>
    </div>
</div>

<div id="mb-help-panel" class="mf-help-panel" role="dialog" aria-labelledby="mb-help-title" style="display: none;">
    <div class="mf-panel-header">
        <h2 id="mb-help-title">Help: MusicBrainz Alignment</h2>
        <button class="mf-panel-close" onclick="metaforge.musicbrainz_id.closeHelp()">×</button>
    </div>
    <div id="mb-help-body" class="mf-panel-body"></div>
</div>

<script>
    (function boot() {
        if (window.metaforge?.musicbrainz_id?.init) { 
            window.metaforge.musicbrainz_id.init(); 
        } else { 
            setTimeout(boot, 50); 
        }
    })();
</script>
<!-- --- END OF FILE musicbrainz_id.mfi --- -->