<!-- --- START OF FILE musicbrainz_id.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: MusicBrainz IDs (pipeline step 2 of 3)
     v2 (2026-11-13): per-tool pass. No inline styles; shared type scale;
     search results are a table with a radio per release; country flags
     are local (ui/images/flags, flag-icons, MIT) with the country name as
     alt text; track order is set by typing numbers + "Apply order" (the
     Settings toolbar pattern, John 2026-11-13), not arrow buttons; the
     commit streams one Activity log entry per file and ends in the shared
     Next-step bar.
     ====================================================================== -->
<style>
    .mb-split-stage {
        display: flex;
        width: 100%;
        height: 100%;
        min-height: 0;
        gap: 1rem;
    }

    /* --- LEFT: FIND THE RELEASE --- */
    .mb-discovery-silo {
        flex: 0 0 calc(42% - 0.5rem);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-width: 0;
        min-height: 0;
    }

    .mb-input-panel {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.9rem;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
    }
    .mb-field-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .mb-label {
        flex: 0 0 6.5rem;
        color: var(--mf-gold);
        font-size: 0.875rem;
        font-weight: 700;
    }
    .mb-label-inline { flex: none; }
    .mb-input {
        flex: 1;
        min-width: 0;
        box-sizing: border-box;
        padding: 0.4rem 0.5rem;
        font-family: var(--font-main);
        font-size: 1rem;
    }
    .mb-input-path { font-family: var(--font-mono); font-size: 0.875rem; }
    .mb-input-count { flex: 0 0 4.5ch; text-align: center; }
    .mb-field-row button { flex: none; }

    .mb-action-row {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }
    .mb-action-row button { flex: none; }
    #mb-status {
        flex: 1;
        margin: 0;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--text-primary);
    }
    #mb-status.is-error { color: var(--status-error); }
    #mb-status.is-ok { color: var(--status-success); }

    .mb-scroll-row { flex: 1; display: flex; min-height: 0; }

    .mb-results-viewport {
        position: relative;   /* contains hidden screen-reader text */
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--surface-page);
        border: 1px solid var(--border-subtle);
    }
    .mb-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.875rem;
    }
    .mb-table th {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 0.4rem 0.5rem;
        background: var(--surface-raised);
        color: var(--mf-gold);
        font-size: 0.8125rem;
        text-align: left;
        border-bottom: 1px solid var(--border-ui);
    }
    .mb-table td {
        padding: 0.45rem 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-primary);
        vertical-align: top;
        overflow-wrap: anywhere;
    }
    .mb-col-pick    { width: 2.25rem; }
    .mb-col-score   { width: 3.5rem; }
    .mb-col-format  { width: 4.75rem; }
    .mb-col-tracks  { width: 3.5rem; }
    .mb-col-year    { width: 3.5rem; }
    .mb-col-country { width: 4.5rem; }
    .mb-table .mb-num { font-variant-numeric: tabular-nums; }
    .mb-release-artist { display: block; font-weight: 700; }
    /* "Bootleg", "Promotion"...: its own line under the format, same size */
    .mb-release-kind { display: block; font-style: italic; }
    .mb-results-note { padding: 1rem 0.75rem; color: var(--text-muted); }
    .mb-results-note.is-error { color: var(--status-error); font-weight: 700; }

    .mb-table tbody tr[data-release-id] { cursor: pointer; }
    .mb-table tbody tr[data-release-id]:hover td { background: var(--surface-raised); }
    .mb-pick {
        margin: 0.15rem 0 0;
        width: 1.125rem;
        height: 1.125rem;
        accent-color: var(--mf-gold);
        cursor: pointer;
    }
    /* Chosen release: the radio is checked and the row is outlined. The
       outline is inset so nothing changes size (no layout shift). */
    .mb-table tbody tr:has(.mb-pick:checked) td {
        background: var(--surface-raised);
        box-shadow: inset 0 2px 0 var(--mf-gold), inset 0 -2px 0 var(--mf-gold);
    }
    .mb-table tbody tr:has(.mb-pick:checked) td:first-child { box-shadow: inset 2px 2px 0 var(--mf-gold), inset 0 -2px 0 var(--mf-gold); }
    .mb-table tbody tr:has(.mb-pick:checked) td:last-child  { box-shadow: inset -2px 2px 0 var(--mf-gold), inset 0 -2px 0 var(--mf-gold); }

    .mb-country { display: inline-flex; align-items: center; gap: 0.3rem; }
    .mb-flag {
        width: 1.33rem;            /* 4:3 */
        height: 1rem;
        border: 1px solid var(--border-subtle);
        flex: none;
    }
    .mb-country-code { font-size: 0.8125rem; color: var(--text-muted); }

    /* --- RIGHT: CONFIRM, ORDER, COMMIT --- */
    .mb-confirm-silo {
        flex: 0 0 calc(58% - 0.5rem);
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        padding: 0.9rem;
        background: var(--surface-page);
        border: 1px solid var(--mf-gold);
        box-sizing: border-box;
    }
    #mb-id-summary {
        margin: 0 0 0.6rem;
        font-size: 0.9375rem;
        color: var(--text-primary);
    }
    #mb-id-summary .mb-summary-id {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--text-muted);
    }
    #mb-id-summary.is-error { color: var(--status-error); font-weight: 700; }

    .mb-alignment-headers,
    .mb-handshake-row {
        display: grid;
        grid-template-columns: 3.25rem 1fr 1fr;
        gap: 0.6rem;
        align-items: start;
    }
    .mb-alignment-headers[hidden] { display: none; }
    .mb-list-header {
        padding: 0.35rem 0.5rem;
        background: var(--surface-raised);
        color: var(--mf-gold);
        font-size: 0.8125rem;
        font-weight: 700;
        border-bottom: 1px solid var(--border-ui);
    }

    .mb-comparison-viewport {
        position: relative;   /* contains hidden screen-reader text */
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        border: 1px solid var(--border-subtle);
        background: var(--surface-page);
    }
    #mb-order-form[hidden], #mb-activity[hidden] { display: none; }
    .mb-order-note { margin: 0; padding: 1rem 0.75rem; color: var(--text-muted); }

    .mb-handshake-row {
        padding: 0.35rem 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    .mb-handshake-row:nth-child(even) { background: var(--surface-raised); }
    .mb-order-input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.2rem 0.3rem;
        font-family: var(--font-main);
        font-size: 0.9375rem;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }
    .mb-order-input[aria-invalid="true"] {
        border-color: var(--status-error);
        outline: 2px solid var(--status-error);
    }
    .mb-local-name {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--text-primary);
        overflow-wrap: anywhere;
        padding-top: 0.2rem;
    }
    .mb-remote-name {
        font-size: 0.9375rem;
        color: var(--text-primary);
        overflow-wrap: anywhere;
        padding-top: 0.15rem;
        padding-left: 0.6rem;
        border-left: 1px solid var(--border-subtle);
    }
    .mb-remote-pos { color: var(--text-muted); font-variant-numeric: tabular-nums; }

    #mb-activity { padding: 0.6rem 0.75rem; }

    .mb-confirm-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1rem;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
    }
    #mb-order-msg {
        flex: 1;
        min-width: 12rem;
        margin: 0;
        font-size: 0.875rem;
        color: var(--text-muted);
    }
    #mb-order-msg.is-error { color: var(--status-error); font-weight: 700; }
    #mb-commit-btn { margin-left: auto; }
    .mb-confirm-silo .mf-handoff { margin: 0.75rem -0.9rem -0.9rem; }
</style>

<div class="mf-page-head">
    <h1 id="mb-id-header" class="main" tabindex="-1">MusicBrainz IDs</h1>
    <button type="button" class="mf-help-btn" data-mf-help="musicbrainz_id" data-mf-help-name="MusicBrainz IDs">Help</button>
</div>

<div class="active_stage">
    <div class="mb-split-stage">

        <!-- LEFT: FIND THE RELEASE. A real <form>: Enter in Album or Artist
             runs the search; Browse is type="button" so Enter never opens it. -->
        <div class="mb-discovery-silo">
            <form class="mb-input-panel" id="mb-search-form" role="search" aria-label="Search MusicBrainz">
                <div class="mb-field-row">
                    <label for="mb-local-path" class="mb-label">Local Source</label>
                    <input type="text" id="mb-local-path" class="mb-input mb-input-path" readonly placeholder="Select album folder...">
                    <button type="button" id="mb-browse-btn" class="mf-button-gold-fixed">Browse</button>
                </div>
                <div class="mb-field-row">
                    <label for="mb-album-input" class="mb-label">Album</label>
                    <input type="text" id="mb-album-input" class="mb-input" placeholder="Album Title">
                </div>
                <div class="mb-field-row">
                    <label for="mb-artist-input" class="mb-label">Artist</label>
                    <input type="text" id="mb-artist-input" class="mb-input" placeholder="Artist Name">
                    <label for="mb-local-track-count" class="mb-label mb-label-inline">Tracks</label>
                    <input type="text" id="mb-local-track-count" class="mb-input mb-input-count" readonly value="--">
                </div>
                <div class="mb-action-row">
                    <button type="submit" class="mf-button-gold-fixed">Search MusicBrainz</button>
                    <p id="mb-status"></p>
                </div>
            </form>

            <div class="mb-scroll-row">
                <div id="mb-results-viewport" class="mb-results-viewport mf-hide-native-scrollbar">
                    <table class="mb-table">
                        <caption class="mf-visually-hidden">MusicBrainz releases. Choose the one that matches your album.</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="mb-col-pick"><span class="mf-visually-hidden">Choose</span></th>
                                <th scope="col" class="mb-col-score">Score</th>
                                <th scope="col">Artist / Album</th>
                                <th scope="col" class="mb-col-format">Format</th>
                                <th scope="col" class="mb-col-tracks">Tracks</th>
                                <th scope="col" class="mb-col-year">Year</th>
                                <th scope="col" class="mb-col-country">Country</th>
                            </tr>
                        </thead>
                        <tbody id="mb-results-body">
                            <tr><td colspan="7" class="mb-results-note">Search to see the matching releases.</td></tr>
                        </tbody>
                    </table>
                </div>
                <!-- Custom scrollbar, shared implementation (layout.css section 10 / MFScrollbar). -->
                <div class="mf-custom-scrollbar" aria-hidden=\"true\" aria-controls="mb-results-viewport">
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                    <div class="mf-scroll-track">
                        <div class="mf-scroll-thumb"></div>
                    </div>
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
                </div>
            </div>
        </div>

        <!-- RIGHT: CONFIRM THE RELEASE, LINE UP THE TRACKS, COMMIT -->
        <!-- No visible heading here (John, 2026-11-15: the tool's icon now
             leads the screen's own <h1>); the region keeps a name for
             screen-reader landmark navigation. -->
        <section class="mb-confirm-silo" aria-label="Confirm the MusicBrainz release">
            <p id="mb-id-summary">Choose a release to see its MusicBrainz details.</p>

            <div class="mb-alignment-headers" id="mb-alignment-headers" aria-hidden="true">
                <div class="mb-list-header">Order</div>
                <div class="mb-list-header">Your files</div>
                <div class="mb-list-header">MusicBrainz tracks</div>
            </div>

            <div class="mb-scroll-row">
                <div id="mb-comparison-viewport" class="mb-comparison-viewport mf-hide-native-scrollbar">
                    <!-- Track order: type a file's intended position, then
                         Apply order (or Enter). The Settings toolbar pattern. -->
                    <form id="mb-order-form" aria-label="Order of your files">
                        <p class="mb-order-note">Your files and the release's tracks appear here, side by side.</p>
                    </form>
                    <!-- Commit results: role="log", not live; the shared
                         announcer speaks steps, errors and the finish. -->
                    <div id="mb-activity" role="log" aria-live="off" aria-label="Activity log" hidden></div>
                </div>
                <div class="mf-custom-scrollbar" aria-hidden=\"true\" aria-controls="mb-comparison-viewport">
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                    <div class="mf-scroll-track">
                        <div class="mf-scroll-thumb"></div>
                    </div>
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
                </div>
            </div>

            <div class="mb-confirm-footer">
                <button type="submit" form="mb-order-form" id="mb-apply-order-btn" class="mf-button-gold-fixed" disabled>Apply order</button>
                <p id="mb-order-msg"></p>
                <button type="button" id="mb-commit-btn" class="mf-button-gold-fixed" disabled>Write IDs and rename files</button>
            </div>

            <!-- Next-step bar (shared .mf-handoff, layout.css section 13): shown
                 only after a clean commit. -->
            <div class="mf-handoff" id="mb-handoff" hidden>
                <p id="mb-next-desc"><span class="mf-handoff-kicker">Next step: 3 of 3.</span> Intelli-Tagger. The album folder and its manifest carry over, so it knows which album to tag.</p>
                <button type="button" class="mf-button-gold-fixed" id="mb-continue-btn" aria-describedby="mb-next-desc">Continue to Intelli-Tagger</button>
            </div>
        </section>
    </div>
</div>

<script>
    (function boot() {
        if (window.metaforge?.musicbrainz_id?.init) {
            window.metaforge.musicbrainz_id.init();
        } else {
            setTimeout(boot, 50);
        }
    })();
</script>
<!-- --- END OF FILE musicbrainz_id.mfi --- -->
