<!-- --- START OF FILE youtube_mp3.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: YouTube to MP3
     v2 (2026-11-16): built. Left: the link (Look up), then the details for
     what was found (a song, a playlist, or a whole album in one video),
     with the action button pinned under its own scroll region. For an
     album video: the track list, then "Check the cuts" with a Play button
     on every cut. Right: progress, Stop, the shared Activity log
     (MFEvents) and the next-step bar to Unpack & Convert.
     ====================================================================== -->
<style>
    .yt-workbench {
        display: flex;
        width: 100%;
        height: 100%;
        gap: 1rem;
        align-items: stretch;
    }
    .yt-workbench [hidden] { display: none !important; }

    /* --- LEFT: LINK AND DETAILS --- */
    .yt-input {
        flex: 0 0 min(max(calc(50% - 0.5rem), 22rem), 58%);   /* widens as text grows */
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
    }
    .yt-lookup {
        padding: 0 0 0.6rem;
        margin-bottom: 0.7rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    .yt-workbench label, .yt-workbench legend { font-size: 0.9375rem; font-weight: 700; color: var(--text-primary); }
    .yt-hint { margin: 0.15rem 0 0.35rem; font-size: 0.875rem; line-height: 1.4; color: var(--text-muted); }
    .yt-row { display: flex; gap: 0.5rem; align-items: center; }
    .yt-row input { flex: 1; min-width: 0; }
    .yt-workbench input[type="text"], .yt-workbench input[type="url"], .yt-workbench textarea {
        font: inherit;
        font-size: 0.9375rem;
        padding: 0.4rem 0.5rem;
        background: var(--surface-field);
        color: var(--text-primary);
        border: 1px solid var(--border-ui);
        border-radius: 3px;
        box-sizing: border-box;
    }
    .yt-workbench input:user-invalid, .yt-workbench textarea:user-invalid { border-color: var(--status-error); border-width: 2px; }
    .yt-error { display: none; margin: 0.3rem 0 0; font-size: 0.875rem; color: var(--status-error); }
    .yt-error.is-shown, :user-invalid ~ .yt-error { display: block; }

    .yt-scroll {
        flex: 1;
        position: relative;   /* contains hidden screen-reader text */
        min-height: 0;
        overflow-y: auto;
        padding: 0.7rem 0.9rem;
        container: yt-panel / inline-size;
    }
    .yt-found-h { margin: 0; color: var(--mf-gold); font-size: 1rem; overflow-wrap: anywhere; }
    .yt-found-meta { margin: 0.2rem 0 0.6rem; font-size: 0.875rem; color: var(--text-muted); }
    .yt-field { display: flex; flex-direction: column; gap: 0.2rem; margin: 0 0 0.7rem; }
    .yt-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0 0.75rem; }
    .yt-workbench fieldset { margin: 0 0 0.7rem; padding: 0.4rem 0.6rem 0.5rem; border: 1px solid var(--border-subtle); }
    .yt-workbench fieldset label { font-weight: 400; }
    .yt-choice { display: flex; gap: 0.4rem; align-items: baseline; margin: 0.25rem 0; }
    .yt-workbench input[type="radio"], .yt-workbench input[type="checkbox"] { accent-color: var(--mf-gold); }
    #yt-titles { resize: vertical; line-height: 1.45; }

    .yt-songs { list-style: none; margin: 0; padding: 0; }
    .yt-song { display: grid; grid-template-columns: auto 1fr auto; gap: 0.5rem; align-items: center; padding: 0.3rem 0; }
    .yt-song input[type="text"] { min-width: 0; }
    .yt-len { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); }

    .yt-review-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem 0.75rem; margin: 0 0 0.35rem; }
    .yt-review-h { margin: 0; color: var(--mf-gold); font-size: 1rem; }
    .yt-path, .yt-found-meta { overflow-wrap: anywhere; }
    .yt-cuts { list-style: none; margin: 0.4rem 0 0; padding: 0; }
    .yt-cut {
        display: grid;
        grid-template-columns: 1.8rem minmax(8rem, 1fr) 6.5rem auto;
        gap: 0.25rem 0.5rem;
        align-items: center;
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--border-subtle);
    }
    .yt-cut:last-child { border-bottom: 0; }
    .yt-num { font-weight: 700; color: var(--text-primary); text-align: right; }
    .yt-cut input[type="text"] { min-width: 0; }
    .yt-cut .yt-start { font-family: var(--font-mono); }
    .yt-play { min-width: 6.5em; }   /* "Play start" and "Stop" take the same width */
    .yt-note { grid-column: 2 / -1; margin: 0; font-size: 0.8125rem; line-height: 1.35; color: var(--text-muted); }
    .yt-note.is-check { color: var(--status-warning); }
    /* Visible column labels; the fields carry their own names for screen readers. */
    .yt-cut-head { padding: 0 0 0.2rem; font-size: 0.8125rem; font-weight: 700; color: var(--text-muted); }
    /* Larger text: a row is title on one line, start time and Play under it,
       instead of scrolling sideways (rem here is the user's text size). */
    @container yt-panel (width < 30rem) {
        .yt-cut {
            grid-template-columns: 1.8rem minmax(0, 1fr) auto;
            grid-template-areas: "num title title" ". start play" ". note note";
        }
        .yt-num { grid-area: num; }
        .yt-cut .yt-title-in { grid-area: title; }
        .yt-cut .yt-start { grid-area: start; max-width: 8rem; }
        .yt-play { grid-area: play; }
        .yt-note { grid-area: note; }
        .yt-cut-head { display: none; }   /* columns no longer line up */
    }

    .yt-foot {
        flex-shrink: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: flex-end;
        padding: 0.6rem 0.9rem;
        border-top: 1px solid var(--border-subtle);
    }
    .yt-intro { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--text-muted); }

    /* --- RIGHT: PROGRESS, STOP, ACTIVITY LOG, NEXT STEP --- */
    .yt-output {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
        /* At large text sizes the next-step bar can outgrow what's left:
           the column then scrolls on its own and the log keeps a usable height. */
        position: relative;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .yt-progress {
        flex-shrink: 0;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 0.4rem 0.9rem;
        padding: 0.6rem 0.9rem 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    #yt-progress-bar {
        height: 0.75rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-ui);
        border-radius: 3px;
        overflow: hidden;
    }
    .yt-progress-fill { height: 100%; width: 0%; transition: width 0.3s ease; }
    #yt-progress-label { grid-column: 1; margin: 0; font-size: 0.9375rem; font-weight: 700; color: var(--text-primary); overflow-wrap: anywhere; }
    #yt-stop { grid-column: 2; grid-row: 1 / span 2; }
    #yt-console-outer { flex: 1; display: flex; min-height: 6rem; }
    #yt-handoff { flex-shrink: 0; }
    .yt-console {
        position: relative;   /* contains hidden "Error:"/"Warning:" labels */
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.75rem 0.9rem;
        color: var(--text-primary);
        line-height: 1.4;
    }
    .yt-log-intro { margin: 0; font-size: 0.9375rem; color: var(--text-muted); }

    /* --- DIALOG --- */
    .yt-dialog {
        width: min(32rem, 90vw);
        padding: 1.1rem 1.25rem;
        background: var(--surface-panel);
        color: var(--text-primary);
        border: 1px solid var(--mf-gold);
        border-radius: 6px;
    }
    .yt-dialog::backdrop { background: rgb(0 0 0 / 0.6); }
    .yt-dialog h2 { margin: 0 0 0.5rem; color: var(--mf-gold); font-size: 1.125rem; }
    .yt-dialog p { margin: 0 0 0.75rem; font-size: 0.9375rem; line-height: 1.45; }
    .yt-dialog-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
</style>

<div class="mf-page-head">
    <h1 class="main" tabindex="-1">YouTube to MP3</h1>
    <button type="button" class="mf-help-btn" data-mf-help="youtube_mp3" data-mf-help-name="YouTube to MP3">Help</button>
</div>

<div class="active_stage">
<div class="yt-workbench">

    <section class="yt-input" aria-label="Link and details">
        <!-- One scroll region for the link AND the details (at 200% text the
             link form alone took half the column); only the action buttons
             are pinned, attached to the details form with form="yt-form". -->
        <div class="yt-scroll">
        <form class="yt-lookup" id="yt-lookup" novalidate>
            <label for="yt-url">YouTube link</label>
            <p class="yt-hint" id="yt-url-hint">A song, a playlist, or a whole album uploaded as one video.</p>
            <div class="yt-row">
                <input type="url" id="yt-url" name="url" required autocomplete="off" autocorrect="off"
                       autocapitalize="none" spellcheck="false" aria-describedby="yt-url-hint" data-error="yt-url-error">
                <button type="submit" class="mf-button-gold-fixed" id="yt-lookup-btn">Look up</button>
            </div>
            <p class="yt-error" id="yt-url-error">Error: paste the address of a YouTube video or playlist.</p>
        </form>

        <p class="yt-intro" id="yt-intro">Paste a link and choose Look up. Each song becomes its own MP3 (V0), saved in the album folder you choose, ready for Unpack &amp; Convert.</p>

        <form class="yt-form" id="yt-form" hidden novalidate>
                <h2 class="yt-found-h" id="yt-found-h" tabindex="-1"></h2>
                <p class="yt-found-meta" id="yt-found-meta"></p>

                <div id="yt-details">
                <fieldset id="yt-kind-set">
                    <legend>This video is</legend>
                    <div class="yt-choice"><input type="radio" name="kind" id="yt-kind-song" value="song"><label for="yt-kind-song">One song</label></div>
                    <div class="yt-choice"><input type="radio" name="kind" id="yt-kind-album" value="album"><label for="yt-kind-album">A whole album: make one MP3 per song</label></div>
                </fieldset>

                <div class="yt-two">
                    <div class="yt-field">
                        <label for="yt-artist">Artist</label>
                        <input type="text" id="yt-artist" name="artist" required data-error="yt-artist-error">
                        <p class="yt-error" id="yt-artist-error">Error: fill in the artist.</p>
                    </div>
                    <div class="yt-field">
                        <label for="yt-album">Album</label>
                        <input type="text" id="yt-album" name="album" required data-error="yt-album-error">
                        <p class="yt-error" id="yt-album-error">Error: fill in the album.</p>
                    </div>
                </div>

                <div class="yt-field" id="yt-title-field">
                    <label for="yt-title">Song title</label>
                    <input type="text" id="yt-title" name="title" required data-error="yt-title-error">
                    <p class="yt-error" id="yt-title-error">Error: fill in the song title.</p>
                </div>

                <div class="yt-field">
                    <label for="yt-folder">Album folder</label>
                    <p class="yt-hint" id="yt-folder-hint">The MP3s go straight into this folder. Make and name it first (the picker has a New folder button). It mustn't have MP3s in it already.</p>
                    <div class="yt-row">
                        <input type="text" id="yt-folder" name="folder" readonly required aria-describedby="yt-folder-hint" data-error="yt-folder-error">
                        <button type="button" class="mf-button-gold-fixed" id="yt-folder-btn">Choose…</button>
                    </div>
                    <p class="yt-error" id="yt-folder-error">Error: choose the album folder.</p>
                </div>
                </div>

                <div class="yt-field" id="yt-titles-field">
                    <label for="yt-titles">Track titles, one per line</label>
                    <p class="yt-hint" id="yt-titles-hint"></p>
                    <textarea id="yt-titles" name="titles" rows="6" required spellcheck="false" aria-describedby="yt-titles-hint" data-error="yt-titles-error"></textarea>
                    <p class="yt-error" id="yt-titles-error">Error: list the track titles, one per line.</p>
                </div>

                <fieldset id="yt-songs-set">
                    <legend id="yt-songs-legend">Songs</legend>
                    <p class="yt-hint">Untick any that don't belong to the album. Titles can be corrected here.</p>
                    <ul class="yt-songs" id="yt-songs"></ul>
                </fieldset>

                <section id="yt-review" aria-labelledby="yt-review-h">
                    <div class="yt-review-top">
                        <h3 class="yt-review-h" id="yt-review-h" tabindex="-1">Check the cuts</h3>
                        <button type="button" class="mf-button-gold-fixed" id="yt-back">Change the track list</button>
                    </div>
                    <p class="yt-hint yt-path" id="yt-saving"></p>
                    <p class="yt-hint" id="yt-review-intro"></p>
                    <div class="yt-cut yt-cut-head" aria-hidden="true"><span></span><span>Song title</span><span>Starts at</span><span></span></div>
                    <ol class="yt-cuts" id="yt-cuts"></ol>
                </section>
        </form>
        </div>
        <div class="yt-foot" id="yt-foot" hidden>
            <button type="submit" form="yt-form" class="mf-button-gold-fixed" id="yt-go">Make the MP3</button>
        </div>
    </section>

    <section class="yt-output" aria-label="Progress and results">
        <div class="yt-progress">
            <div id="yt-progress-bar" role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="yt-progress-fill" class="yt-progress-fill mf-progress-shimmer"></div>
            </div>
            <p id="yt-progress-label">Standing by</p>
            <button type="button" class="mf-button-gold-fixed" id="yt-stop" disabled>Stop</button>
        </div>
        <div id="yt-console-outer">
            <!-- role="log" but NOT live: steps, problems and the finish are
                 spoken by the shared announcer (MFAnnounce). -->
            <div id="yt-console" class="yt-console mf-hide-native-scrollbar" role="log" aria-live="off" aria-label="Activity log">
                <p class="yt-log-intro">Results appear here.</p>
            </div>
            <!-- Custom scrollbar, shared implementation (layout.css section 10 / MFScrollbar). -->
            <div class="mf-custom-scrollbar" role="scrollbar" aria-controls="yt-console" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                <div class="mf-scroll-track">
                    <div class="mf-scroll-thumb"></div>
                </div>
                <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
            </div>
        </div>
        <!-- Next-step bar (shared .mf-handoff, layout.css section 13). -->
        <div class="mf-handoff" id="yt-handoff" hidden>
            <p id="yt-next-desc"><span class="mf-handoff-kicker">Next step</span> Unpack &amp; Convert adds cover art and sets up the album. It only re-encodes MP3s if you tick Loudness Normalization.</p>
            <button type="button" class="mf-button-gold-fixed" id="yt-continue" aria-describedby="yt-next-desc">Continue to Unpack &amp; Convert</button>
        </div>
    </section>

</div>
</div>

<dialog class="yt-dialog" id="yt-leave" aria-labelledby="yt-leave-h">
    <form method="dialog">
        <h2 id="yt-leave-h">Stop and leave?</h2>
        <p>The download or the MP3s being made stop now. MP3s already finished are kept.</p>
        <div class="yt-dialog-actions">
            <button type="submit" class="mf-button-gold-fixed" value="stay" autofocus>Keep going</button>
            <button type="submit" class="mf-button-gold-fixed" value="leave">Stop and leave</button>
        </div>
    </form>
</dialog>
<!-- --- END OF FILE youtube_mp3.mfi --- -->
