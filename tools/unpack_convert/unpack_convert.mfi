<!-- --- START OF FILE unpack_convert.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: Unpack & Convert
     v2 (2026-11-13): per-tool pass. No inline styles; shared type scale;
     native checkboxes; the form's Start button is its submit button (Enter
     starts the run); progress status is plain text beside a named
     progressbar. Shared pieces live in ui/css/layout.css: Activity log
     events (section 11), cover picker (12), Next-step bar (13).
     ====================================================================== -->
<style>
    /* --- WORKBENCH LAYOUT: form on the left, Activity log on the right --- */
    .unpacker-stage-wrapper {
        display: flex;
        width: 100%;
        gap: 1rem;
        align-items: stretch;
        max-height: 72vh;
    }

    /* The form scrolls on its own if it can't fit (CLAUDE.md: regions that
       can outgrow the window scroll by themselves; the shell never does). */
    .unpacker-interview-side {
        flex: 0 0 calc(35% - 0.5rem);
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        scroll-padding-bottom: 4.5rem;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
    }

    .unpacker-console-side {
        flex: 0 0 calc(65% - 0.5rem);
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
        overflow: hidden;
    }

    /* --- THE FORM --- */
    #unpacker-interview-form { flex: 1; display: flex; flex-direction: column; }
    #upk-fieldset {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 0;
        padding: 0.9rem;
        border: 0;
        min-width: 0;
    }

    .upk-field { display: flex; flex-direction: column; gap: 0.25rem; }
    .upk-field[hidden] { display: none; }
    .upk-field > label {
        color: var(--mf-gold);
        font-size: 0.875rem;
        font-weight: 700;
    }

    .upk-input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.4rem 0.5rem;
        font-family: var(--font-main);
        font-size: 1rem;
    }
    .upk-input-path { font-family: var(--font-mono); font-size: 0.875rem; }
    .upk-path-row { display: flex; gap: 0.5rem; }
    .upk-path-row .upk-input { flex: 1; min-width: 0; }
    .upk-path-row button { flex: none; }

    /* Lockable fields (Filing Artist / Filing Category) */
    .upk-field-wrap { position: relative; }
    .upk-lockable-select { appearance: none; }
    .upk-lockable-select,
    .upk-lockable-input { padding-right: 2.25rem; }
    .upk-lockable-select:disabled,
    .upk-lockable-input:disabled { cursor: default; }

    .upk-lock-btn {
        position: absolute;
        right: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        width: 1.75rem;
        height: 1.75rem;
        display: grid;
        place-content: center;
        padding: 0;
        background: none;
        border: 1px solid transparent;
        border-radius: 4px;
        cursor: pointer;
    }
    .upk-lock-icon {
        width: 1rem;
        height: 1rem;
        display: inline-block;
        background-color: var(--input-foreground2);
        mask: url('/ui/images/un-lock.svg') center / contain no-repeat;
    }
    .upk-lock-btn:hover .upk-lock-icon,
    .upk-lock-btn:focus-visible .upk-lock-icon { background-color: var(--mf-gold); }
    .upk-lock-btn.locked {
        background: var(--surface-panel);
        border-color: var(--border-ui);
    }
    .upk-lock-btn.locked .upk-lock-icon {
        background-color: var(--mf-gold);
        mask-image: url('/ui/images/lock.svg');
    }

    /* Option groups: still real fieldsets (the legend names the group for
       screen readers), but they LOOK like the other fields (John,
       2026-11-13): the legend is an ordinary left-aligned label, and the
       box below it has exactly the text inputs' background and border. */
    .upk-options {
        margin: 0;
        padding: 0;
        border: 0;
        min-width: 0;
    }
    .upk-options[hidden] { display: none; }
    .upk-options legend {
        padding: 0;
        margin-bottom: 0.25rem;
        color: var(--mf-gold);
        font-size: 0.875rem;
        font-weight: 700;
    }
    .upk-options-box {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.5rem;
        background-color: var(--input-background2);
        border: 1px solid var(--border-ui);
    }
    .upk-check {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: start;
        gap: 0.5rem;
    }
    .upk-check input {
        margin: 0.15rem 0 0;
        width: 1.125rem;
        height: 1.125rem;
        accent-color: var(--mf-gold);
        cursor: pointer;
    }
    .upk-check label {
        font-size: 0.9375rem;
        line-height: 1.4;
        color: var(--text-primary);
        cursor: pointer;
    }
    .upk-hint {
        margin: 0;
        padding-left: 1.625rem;   /* lines up with the checkbox label text */
        font-size: 0.875rem;
        line-height: 1.4;
        color: var(--text-muted);
    }
    .upk-hint a { color: var(--mf-gold); font-weight: 700; }
    .upk-hint a:hover { color: var(--text-primary); }
    .upk-ext-icon {
        display: inline-block;
        width: 0.7em;
        height: 0.7em;
        margin-left: 0.15em;
        background-color: currentColor;
        mask: url('/ui/images/external_link.svg') center / contain no-repeat;
    }
    .upk-warn-word { color: var(--status-error); font-weight: 700; }

    /* Start stays in view at the bottom of the panel even when the form is
       taller than the window (first use, with the consent box showing).
       The panel's scroll-padding keeps a focused field from sliding under
       it (WCAG 2.4.11 Focus Not Obscured). */
    .upk-actions {
        position: sticky;
        bottom: 0;
        margin: auto -0.9rem -0.9rem;
        padding: 0.6rem 0.9rem;
        border-top: 1px solid var(--border-subtle);
        background: var(--surface-page);
        text-align: right;
    }

    /* --- PROGRESS: a named progressbar + a plain status line --- */
    .upk-progress {
        flex-shrink: 0;
        padding: 0.6rem 0.9rem 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    #upk-progress-container {
        height: 0.75rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-ui);
        border-radius: 3px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        width: 0%;
        transition: width 0.4s ease;
    }
    #upk-progress-label {
        margin: 0.4rem 0 0;
        font-family: var(--font-main);
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    /* --- ACTIVITY LOG --- */
    #upk-console-outer { flex: 1; display: flex; min-height: 0; }
    .unpacker-console {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem 0.9rem;
        color: var(--text-primary);
        line-height: 1.4;
    }
    .upk-log-intro {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--text-muted);
    }
</style>

<div class="mf-page-head">
    <h1 id="unpack-header" class="main" tabindex="-1">Unpack &amp; Convert</h1>
    <button type="button" class="mf-help-btn" data-mf-help="unpack_convert" data-mf-help-name="Unpack &amp; Convert">Help</button>
</div>

<div class="active_stage">
    <div class="unpacker-stage-wrapper">

        <!-- LEFT: THE ALBUM DETAILS. Start is the form's submit button, so
             Enter in any field starts the run once everything is filled in. -->
        <div class="unpacker-interview-side">
            <form id="unpacker-interview-form" novalidate>
                <fieldset id="upk-fieldset">

                    <div class="upk-field">
                        <label for="upk-path">Source Directory</label>
                        <div class="upk-path-row">
                            <input type="text" id="upk-path" class="upk-input upk-input-path" readonly placeholder="Select album folder...">
                            <button type="button" id="upk-browse-btn" class="mf-button-gold-fixed">Browse</button>
                        </div>
                    </div>

                    <div class="upk-field">
                        <label for="upk-album">Album Title (Required)</label>
                        <input type="text" id="upk-album" class="upk-input" placeholder="e.g. The Dark Side Of the Moon" required>
                    </div>

                    <div class="upk-field">
                        <label for="upk-artist">Filing Artist (Required)</label>
                        <div class="upk-field-wrap">
                            <input type="text" id="upk-artist" class="upk-input upk-lockable-input" placeholder="e.g. Pink Floyd" required>
                            <button type="button" id="upk-artist-lock" class="upk-lock-btn" aria-pressed="false" aria-label="Lock Filing Artist so it stays set for the next album" title="Lock Filing Artist">
                                <span class="upk-lock-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>

                    <div id="enhanced-section" class="upk-field" hidden>
                        <label for="upk-category">Filing Category (Required)</label>
                        <div class="upk-field-wrap">
                            <select id="upk-category" class="upk-input upk-lockable-select">
                                <option value="">-- Loading Categories --</option>
                            </select>
                            <button type="button" id="upk-category-lock" class="upk-lock-btn" aria-pressed="false" aria-label="Lock Filing Category so it stays set for the next album" title="Lock Filing Category">
                                <span class="upk-lock-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>

                    <fieldset class="upk-options">
                        <legend>Processing Details</legend>
                        <div class="upk-options-box">
                        <div class="upk-check">
                            <input type="checkbox" id="upk-norm" aria-describedby="upk-norm-hint">
                            <label for="upk-norm">Apply Loudness Normalization</label>
                        </div>
                        <p class="upk-hint" id="upk-norm-hint">
                            Increases conversion time. Recommended for mixed sources.
                            <a href="https://tech.ebu.ch/loudness" target="_new">About EBU R 128<span class="upk-ext-icon" aria-hidden="true"></span><span class="mf-visually-hidden"> (opens in a new window)</span></a>
                        </p>
                        </div>
                    </fieldset>

                    <fieldset class="upk-options" id="upk-consent-gate" hidden>
                        <legend>Consent</legend>
                        <div class="upk-options-box">
                        <div class="upk-check">
                            <input type="checkbox" id="upk-consent" required>
                            <label for="upk-consent">I acknowledge that MetaForge will convert audio, rename files, and <strong class="upk-warn-word">delete</strong> original archives and legacy metadata.</label>
                        </div>
                        <div class="upk-check">
                            <input type="checkbox" id="upk-remember" aria-describedby="upk-remember-hint">
                            <label for="upk-remember">Remember this decision.</label>
                        </div>
                        <p class="upk-hint" id="upk-remember-hint">You can change it later in Settings &gt; Config &amp; API keys.</p>
                        </div>
                    </fieldset>

                    <div class="upk-actions">
                        <button type="submit" id="upk-start-btn" class="mf-button-gold-fixed" disabled>Unpack / Convert</button>
                    </div>

                </fieldset>
            </form>
        </div>

        <!-- RIGHT: PROGRESS, THE ACTIVITY LOG, THE NEXT STEP -->
        <div class="unpacker-console-side">
            <div class="upk-progress">
                <div id="upk-progress-container" role="progressbar" aria-label="Unpack and convert progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div id="upk-progress-fill" class="progress-fill mf-progress-shimmer"></div>
                </div>
                <p id="upk-progress-label">Standing By</p>
            </div>
            <div id="upk-console-outer">
                <!-- role="log" but NOT live (aria-live="off"). Steps, errors,
                     warnings and the finish are spoken by the shared announcer
                     (MFAnnounce); the full log is read on demand. -->
                <div id="unpacker-console" class="unpacker-console mf-hide-native-scrollbar" role="log" aria-live="off" aria-label="Activity log">
                    <p class="upk-log-intro">Provide album details and select a source directory to begin.</p>
                </div>
                <!-- Custom scrollbar, shared implementation (layout.css
                     section 10, MFScrollbar in metaforge_core.js). -->
                <div class="mf-custom-scrollbar" role="scrollbar" aria-controls="unpacker-console" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                    <div class="mf-scroll-track">
                        <div class="mf-scroll-thumb"></div>
                    </div>
                    <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
                </div>
            </div>
            <!-- Next-step bar (shared .mf-handoff, layout.css section 13): shown
                 when the run is finished; Continue carries the album folder over. -->
            <div class="mf-handoff" id="upk-handoff" hidden>
                <p id="upk-next-desc"><span class="mf-handoff-kicker">Next step: 2 of 3.</span> MusicBrainz IDs. The album folder and its manifest carry over, so the fields fill in for you.</p>
                <button type="button" class="mf-button-gold-fixed" id="upk-continue-btn" aria-describedby="upk-next-desc">Continue to MusicBrainz IDs</button>
            </div>
        </div>

    </div>
</div>

<script>
    (function fragmentAwakener() {
        if (window.metaforge?.unpack_convert?.init) {
            window.metaforge.unpack_convert.init();
        } else {
            setTimeout(fragmentAwakener, 50);
        }
    })();
</script>
<!-- --- END OF FILE unpack_convert.mfi --- -->
