<!-- --- START OF FILE unpack_convert.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: Unpack & Convert
     Build 7.8.8: Optimized Mask-based Iconography for Theme Sync.
     Accessibility: WCAG 2.2 AA | COGA 4.8.4
     ====================================================================== -->
<style>
    /* --- WORKBENCH LAYOUT (Strict 50/50 High-Density) --- */
    .unpacker-stage-wrapper {
        display: flex;
        width: 100%;
        gap: 15px;
        align-items: stretch;
        max-height: 72vh;
    }

    .unpacker-interview-side {
        flex: 0 0 calc(35% - 7.5px);
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    .unpacker-interview-side fieldset:disabled {
        border: none;
        margin: 0;
        padding: 0;
        opacity: 1; 
    }

    .unpacker-console-side {
        flex: 0 0 calc(65% - 7.5px);
        display: flex;
        flex-direction: column;
        background: var(--bg-main);
        border: 3px solid var(--bg-accent);
        box-sizing: border-box;
        overflow: hidden;
    }

    /* --- CONDENSED INTERVIEW FORM --- */
    .unpacker-interview-grid {
        background: var(--bg-main);
        padding: 15px; 
        border: 3px solid var(--bg-accent);
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: 100%;
    }

    .interview-group { display: flex; flex-direction: column; gap: 2px; }
    .interview-group label {
        color: var(--mf-gold);
        font-size: 0.7rem;
        font-weight: bold;
        letter-spacing: 0.5px;
    }

    .mf-hint {
        font-size: 0.6rem;
        color: var(--text-message);
        font-style: italic;
        margin-top: 2px;
        line-height: 1.2;
    }

    /* --- PERSISTENT PROGRESS ENGINE (Sticky) --- */
    #upk-progress-container {
        /* Same "no visible track" gap as Intelli-Tagger's progress bar
           (John, 2026-08-11) -- var(--bg-main) is just the page
           background, so the unfilled portion had no fixed-length
           reference to judge the fill against. var(--bg-accent) + a
           border give it a real, bounded track. */
        background: var(--bg-accent);
        border: 1px solid #000;
        border-radius: 2px;
        height: 20px;
        position: sticky;
        top: 0;
        z-index: 10;
        flex-shrink: 0;
        margin-bottom: 25px;
    }

    .progress-fill {
        background: var(--mf-gold);
        height: 100%;
        width: 0%;
        border-radius: 1px;
        transition: width 0.4s ease;
    }

    .progress-text {
        position: absolute;
        width: 100%;
        text-align: center;
        line-height: 30px;
        font-size: 0.7rem;
        font-weight: bold;
        color: var(--text-output);
        mix-blend-mode: difference;
    }

    /* --- CONSOLE LOG --- */
    .unpacker-console {
        color: var(--text-output);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0 15px 15px 15px;
        overflow-y: auto;
        flex: 1;
        line-height: 1.4;
    }
    .unpacker-console::-webkit-scrollbar {
        display: none;
    }

    /* CUSTOM SCROLLBAR for #unpacker-console -- same pattern/reasoning as
       Personnel Scout's .p-custom-scrollbar (see that file's comment for
       the full history of why native ::-webkit-scrollbar-button was
       abandoned). Sized to John's 2.5:1 height:width spec -- 16px wide,
       so 40px tall buttons. */
    .upk-custom-scrollbar {
        width: 16px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        background: var(--bg-accent);
        border: 1px solid #000;
    }
    .upk-scroll-btn {
        width: 100%;
        height: 40px;
        flex-shrink: 0;
        background: none;
        border: none;
        /* !important needed -- layout.css's global `button { color:
           var(--input-foreground) !important; }` (meant for the app's
           normal gold-background action buttons) otherwise silently wins
           over this. Same fix as Personnel Scout's .p-scroll-btn. */
        color: var(--mf-gold) !important;
        font-size: 11px;
        line-height: 40px;
        text-align: center;
        padding: 0;
        cursor: pointer;
    }
    .upk-scroll-btn:hover {
        color: var(--text-output) !important;
    }
    .upk-scroll-track {
        flex: 1;
        position: relative;
        cursor: pointer;
    }
    .upk-scroll-thumb {
        position: absolute;
        left: 2px;
        right: 2px;
        background: var(--mf-gold);
        border: 1px solid #000;
        border-radius: 3px;
        min-height: 20px;
        cursor: grab;
    }
    .upk-scroll-thumb:hover {
        background: var(--text-output);
    }
    .upk-scroll-thumb.dragging {
        cursor: grabbing;
    }

    /* --- ART GALLERY ARCHITECTURE --- */
    .art-selection-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 10px;
    }

    .art-card {
        background: var(--bg-main);
        border: 2px solid var(--bg-accent);
        padding: 6px;
        cursor: pointer;
        transition: border-color 0.1s ease;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .art-card:hover, .art-card:focus-within {
        border-color: var(--mf-gold);
    }

    .art-card.selected {
        border-color: var(--mf-gold);
        background: rgba(204, 153, 0, 0.1);
    }

    .art-preview {
        width: 100%;
        aspect-ratio: 1/1;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        border: 1px solid #000;
    }

    .art-meta {
        font-size: 0.55rem;
        color: var(--text-message);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .art-selector-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        border-top: 1px solid var(--bg-accent);
        padding-top: 4px;
    }

    .art-radio {
        appearance: none;
        width: 12px;
        height: 12px;
        background: #fff;
        border: 1px solid var(--mf-gold);
        border-radius: 50%;
        cursor: pointer;
        display: grid;
        place-content: center;
    }

    .art-radio:checked::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--mf-gold);
    }

    /* --- CHECKBOX ARCHITECTURE --- */
    .consent-box {
        padding: 12px;
        background: var(--bg-accent);
        border: 1px solid var(--bg-accent);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .consent-row { display: flex; align-items: flex-start; gap: 12px; }

    .silo-checkbox {
        appearance: none;
        -webkit-appearance: none;
        width: 16px !important;
        height: 16px !important;
        min-width: 16px !important;
        min-height: 16px !important;
        flex-shrink: 0 !important;
        background-color: var(--bg-main);
        border: 1px solid var(--mf-gold);
        border-radius: 2px;
        cursor: pointer;
        position: relative;
        margin: 0;
        display: grid; place-content: center;
    }

    .silo-checkbox:checked { background-color: var(--mf-gold); }
    .silo-checkbox::before {
        content: ""; width: 8px; height: 8px; transform: scale(0);
        transition: 100ms transform ease-in-out; background-color: var(--bg-main);
        clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
    }
    .silo-checkbox:checked::before { transform: scale(1); }

    .consent-row label {
        color: var(--text-message);
        font-size: 0.65rem;
        cursor: pointer;
        line-height: 1.3;
        margin-top: -2px;
    }

    /* Visual Indicators */
    .unpacker-console .status-api { 
        color: var(--mf-gold); 
        font-weight: bold; 
        display: block; 
        border-bottom: 1px solid var(--bg-main); 
        margin-bottom: 5px; 
        padding-bottom: 2px; 
    }
    .unpacker-console .status-success { color: var(--status-success); }
    .unpacker-console .status-error { 
        color: var(--status-error); 
        font-weight: bold; 
        margin: 8px 0; 
        padding: 4px; 
        border-left: 3px solid var(--status-error); 
        background: var(--bg-main); 
    }

    /* --- ICON THEME SYNC ENGINE (NEW) --- */
    .ebu-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--mf-gold);
        text-decoration: underline;
        font-weight: bold;
    }
    .ebu-link:hover, .ebu-link:focus-visible {
        color: var(--text-output);
    }
    
    .mf-ext-icon-mask {
        width: 10px;
        height: 10px;
        background-color: currentColor; /* Inherits var(--mf-gold) from .ebu-link */
        -webkit-mask-image: url('/ui/images/external_link.svg');
        mask-image: url('/ui/images/external_link.svg');
        -webkit-mask-size: contain;
        mask-size: contain;
        mask-repeat: no-repeat;
        display: inline-block;
    }

    /* Button State Overrides */
    #upk-start-btn:disabled {
        background-color: var(--bg-accent) !important; 
        color: var(--text-message) !important; 
        border-color: var(--bg-main) !important; 
        cursor: not-allowed;
        opacity: 0.5;
    }
	
	    .mb-input-text {
        background: var(--input-background2);
        border: 1px solid #444;
        color: var(--input-foreground);
        padding: 6px;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        width: 100%;
    }

    /* --- Filing Category lock toggle ---
       Lets John pin the Category select across multiple albums by the
       same artist instead of re-picking it every time. Locked = read-only
       (matches the padlock metaphor -- unlock to change it), and the
       locked value/state is remembered at the JS-module level (see
       toggleCategoryLock in unpack_convert.js) so it survives navigating
       away to another tool and back, which fully rebuilds this DOM. */
    .upk-field-wrap { position: relative; }

    .upk-lockable-select {
        appearance: none;
        -webkit-appearance: none;
        padding-right: 34px !important;
    }
    .upk-lockable-select:disabled {
        /* John's report, 2026-08-11: locking should only change the
           button's appearance, not the field itself -- removed the
           background swap that used to make the whole input go grey. */
        opacity: 1; /* stay fully legible while locked, not greyed out */
        cursor: default;
    }

    .upk-lock-btn {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        display: grid;
        place-content: center;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        /* John's report, 2026-08-11: the icon vanished after choosing a
           category. Root cause -- layout.css's global :focus-visible rule
           forces z-index:999 !important onto whatever's currently
           focused, and the select regains focus the instant its native
           dropdown closes. Since this button sits INSIDE the select's own
           reserved right-padding area by design, the now-elevated select
           painted its opaque white background right over it. Needs to
           beat that 999, not just have "a" z-index. */
        z-index: 1000;
    }
    .upk-lock-icon {
        width: 15px;
        height: 15px;
        display: inline-block;
        /* --input-foreground is theme-flipped (black in dark theme,
           WHITE in light theme -- it's meant for text ON an accent-
           colored button, not an icon sitting on the always-white input
           field). Using it here was invisible in light theme (1:1).
           --input-foreground2 is the correct one -- fixed black in both
           themes, same variable the sibling text inputs already use. */
        background-color: var(--input-foreground2);
        -webkit-mask-image: url('/ui/images/un-lock.svg');
        mask-image: url('/ui/images/un-lock.svg');
        -webkit-mask-size: contain;
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
    }
    .upk-lock-btn:hover .upk-lock-icon,
    .upk-lock-btn:focus-visible .upk-lock-icon {
        background-color: var(--mf-gold);
    }
    .upk-lock-btn.locked {
        /* John's report, 2026-08-11: gold-on-white was only 2.58:1,
           below the 3:1 non-text minimum -- verified via the real WCAG
           relative-luminance formula, not eyeballed. bg-stage behind the
           icon fixes that (5.18:1 dark theme). The border is needed too:
           bg-stage vs the white field is only 1.50:1 in light theme --
           without it the button barely reads as a distinct control
           there, even though the icon-on-button contrast itself is fine. */
        background: var(--bg-stage);
        border: 1px solid #000;
        border-radius: 4px;
    }
    .upk-lock-btn.locked .upk-lock-icon {
        background-color: var(--mf-gold);
        -webkit-mask-image: url('/ui/images/lock.svg');
        mask-image: url('/ui/images/lock.svg');
    }
</style>

<h1 id="unpack-header" class="main" tabindex="-1">Unpack &amp; Convert</h1>

<section class="unpack_convert-description" aria-labelledby="unpack_convert-info-label">
    <h2 id="unpack_convert-info-label" class="mf-grid-heading" style="display:none;">Tool Description</h2>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
		<p class="data-text tool_notes">Unpack &amp; Convert unboxes .cue, .wv, .zip, .rar, and .iso (SACD or raw Audio-CD image) files, and converts them to the high-quality .mp3 VBR (V0) format.<br>It then applies an intelligent 'clean-up', leaving your album folders in pristine shape and ready for continued tagging.</p>
        <button class="mf-button-gold-fixed" 
                style="font-size:80%;margin-left:1.5rem; margin-right: 5rem;"
                onclick="metaforge.unpack_convert.openHelp()" 
                aria-label="Open Unpack &amp; Convert help documentation">
            Help
        </button>
    </div>
</section>

<div class="active_stage">
    <div class="unpacker-stage-wrapper">
        
        <!-- LEFT: THE INTERVIEW -->
        <div class="unpacker-interview-side">
            <form id="unpacker-interview-form" oninput="if(window.metaforge.unpack_convert) metaforge.unpack_convert.validate()">
                <fieldset id="upk-fieldset" style="border:none; padding:0; margin:0;">
                <div class="unpacker-interview-grid">
				
					<div class="interview-group">
                        <label for="upk-path">Source Directory</label>
                        <div style="display: flex; gap: 8px;">
                            <input type="text" id="upk-path" class="mb-input-text" style="color:var(--input-foreground2)" readonly style="flex:1;" placeholder="Select album folder...">
                            <button type="button" class="mf-button-gold-fixed" onclick="metaforge.unpack_convert.pickFolder()">Browse</button>
						</div>
                    </div>

                    <div class="interview-group">
                        <label for="upk-artist">Filing Artist (Required)</label>
                        <input type="text" id="upk-artist" class="mb-input-text" style="color:var(--input-foreground2)" placeholder="e.g. Pink Floyd" required>
                    </div>

                    <div class="interview-group">
                        <label for="upk-album">Album Title (Required)</label>
                        <input type="text" id="upk-album" class="mb-input-text" style="color:var(--input-foreground2)" placeholder="e.g. The Dark Side Of the Moon" required>
                    </div>

                    <div id="enhanced-section" class="interview-group" style="display: none;">
                        <label for="upk-category">Filing Category (Required)</label>
                        <div class="upk-field-wrap">
                            <select id="upk-category" class="mb-input-text upk-lockable-select" style="color:var(--input-foreground2)">
                                <option value="">-- Loading Categories --</option>
                            </select>
                            <button type="button" id="upk-category-lock" class="upk-lock-btn" aria-pressed="false" aria-label="Lock Filing Category so it stays set for the next album" title="Lock Filing Category" onclick="metaforge.unpack_convert.toggleCategoryLock()">
                                <span class="upk-lock-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>

                    <div class="consent-box" style="background: rgba(204, 153, 0, 0.05); border: 1px solid var(--mf-gold);">
                        <div id="processing-details" class="interview-group">
                            <label for="processing-details" style="margin-bottom:5px;">Processing Details</label>
                            <div class="consent-row">
                                <input type="checkbox" id="upk-norm" class="silo-checkbox">
                                <label for="upk-norm">
                                    <strong>Apply Loudness Normalization</strong>
                                    <span style="font-size:80%">
                                        (<a href="https://tech.ebu.ch/loudness" target="_new" class="ebu-link" aria-label="Learn more about EBU R 128 loudness normalization (opens in a new window)">
                                            EBU R128 <span class="mf-ext-icon-mask"></span></a>)
                                        
                                    </span>
                                    <br>
                                    <span class="mf-hint">⚠️ Increases conversion time. Recommended for mixed sources.</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="consent-box" id="upk-consent-gate">
                        <div class="consent-row">
                            <input type="checkbox" id="upk-consent" class="silo-checkbox" required>
                            <label for="upk-consent">
                                <strong>Consent:</strong> I acknowledge that MetaForge will convert audio, rename files, and <span style="color:var(--status-error); font-weight:bold;">DELETE</span> original archives and legacy metadata.
                            </label>
                        </div>
                        <div class="consent-row">
                            <input type="checkbox" id="upk-remember" class="silo-checkbox">
                            <label for="upk-remember">Remember this decision.</label>
                        </div>
                    </div>

                    <div style="text-align: right; border-top: 1px solid var(--bg-main); padding-top: 10px; margin-top: auto;">
                        <button type="button" id="upk-start-btn" class="mf-button-gold-fixed" onclick="metaforge.unpack_convert.run()" disabled>
                            Unpack / Convert
                        </button>
                    </div>
                </div>
                </fieldset>
            </form>
        </div>

        <!-- RIGHT: THE OUTPUT WORKFLOW -->
        <div class="unpacker-console-side">
            <div id="upk-progress-container" role="progressbar" aria-valuemin="0" aria-valuemax="100">
                <div id="upk-progress-fill" class="progress-fill mf-progress-shimmer" style="margin-bottom:5px;"></div>
                <h2 id="upk-progress-label" class="progress-text" style="font-size:1rem; border-bottom: 1px solid var(--mf-gold);background-color:var(--bg-main); margin-top:-5px;padding-top:-30px;">Standing By</h2>
			</div>
            <div id="upk-console-outer" style="flex: 1; display: flex; min-height: 0;">
                <div id="unpacker-console" class="unpacker-console" aria-live="polite" style="padding:10px;">
                    <div class="data-text" >Provide album details and select a source directory to begin.</div>
                </div>
                <!-- Custom scrollbar (John's report, 2026-08-11): same
                     pattern built for Personnel Scout's #p-mapping-viewport
                     -- real DOM, not native ::-webkit-scrollbar-button
                     (which proved unreliable across four separate attempts
                     there). Wired in unpack_convert.js's
                     initCustomScrollbar()/syncScrollbar(). Tool-scoped
                     `upk-` class names, not reused from personnel.mfi's
                     `p-` classes, to avoid any cross-tool CSS collision. -->
                <div class="upk-custom-scrollbar" id="upk-custom-scrollbar" role="scrollbar" aria-controls="unpacker-console" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <button type="button" class="upk-scroll-btn" id="upk-scroll-up" aria-label="Scroll up" tabindex="-1" onclick="metaforge.unpack_convert.nudgeScroll(-1)">▲</button>
                    <div class="upk-scroll-track" id="upk-scroll-track" onclick="metaforge.unpack_convert.trackClick(event)">
                        <div class="upk-scroll-thumb" id="upk-scroll-thumb"></div>
                    </div>
                    <button type="button" class="upk-scroll-btn" id="upk-scroll-down" aria-label="Scroll down" tabindex="-1" onclick="metaforge.unpack_convert.nudgeScroll(1)">▼</button>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- FLOATING HELP PANEL -->
<div id="upk-help-panel" class="mf-help-panel" role="dialog" aria-labelledby="upk-panel-title" style="display: none;">
    <div class="mf-panel-header">
        <h2 id="upk-panel-title">Help: Unpack &amp; Convert</h2>
        <button class="mf-panel-close" onclick="metaforge.unpack_convert.closeHelp()" aria-label="Close help panel">×</button>
    </div>
    <div id="upk-help-body" class="mf-panel-body"></div>
</div>

<script>
    (function fragmentAwakener() {
        if (window.metaforge?.unpack_convert?.init) { 
            window.metaforge.unpack_convert.init(); 
        } else { 
            setTimeout(fragmentAwakener, 50); 
        }
    })();
</script>
<!-- --- END OF FILE unpack_convert.mfi --- -->