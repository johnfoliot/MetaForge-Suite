<!-- ======================================================================
     MetaForge Tool UI: Dashboard
     v2 (2026-11-16). The frame: tiles are plug-ins in tiles\<id>\ (found
     like tools are), laid out in Settings > Dashboard
     (data\dashboard\layout.json); each loads its own data. Plan:
     D:\MetaForge Work files\Dashboard_Audit_2026-11-16.md
     ====================================================================== -->
<style>
    .db-stage {
        flex: 1;
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        container: db-stage / inline-size;
    }
    .db-bar { display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem; flex-wrap: wrap; }
    .db-bar-status { flex: 1; margin: 0; font-size: 0.875rem; color: var(--text-muted); }
    .db-btn-quiet {
        background: transparent !important;
        color: var(--mf-gold) !important;
        border: 1px solid var(--mf-gold) !important;
    }

    /* The tiles: one grid, scrolling on its own. 3 columns at 1280 px,
       fewer as text grows (the minimum tile width is in rem). DOM order is
       the visual order: no `order`, no dense packing. */
    .db-tiles {
        position: relative;          /* contains hidden screen-reader text */
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
        grid-auto-rows: min-content;
        align-content: start;
        gap: 0.9rem;
        padding: 0.2rem;             /* room for focus rings */
    }
    .db-tile {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.9rem 1rem;
        background: var(--surface-panel);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        min-width: 0;
    }
    .db-w2 { grid-column: span 2; }
    .db-w3 { grid-column: 1 / -1; }
    /* Two columns left: a 3-wide tile takes the row. One column left (large
       text): wide tiles must not force an off-screen column.
       2 x 19rem + gap = 38.9rem; 3 x 19rem + 2 gaps = 58.8rem. */
    @container db-stage (width < 59rem) { .db-w3 { grid-column: span 2; } }
    @container db-stage (width < 39rem) { .db-w2, .db-w3 { grid-column: auto; } }

    .db-tile h2 { margin: 0; font-size: 1.125rem; color: var(--mf-gold); }
    .db-tile p { margin: 0; }
    .db-body { display: flex; flex-direction: column; gap: 0.6rem; }
    .db-muted { color: var(--text-muted); font-size: 0.9375rem; }
    .db-big { font-size: 1.75rem; font-weight: 700; color: var(--text-primary); }
    .db-error { color: var(--status-error); }
    .db-tile footer { display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem; flex-wrap: wrap; margin-top: auto; }
    .db-tile footer .db-muted { flex: 1; min-width: 10rem; }

    /* Shared tile styles (any tile may use these). A tile's own styles live
       in its tiles\<id>\tile.css. */
    /* Lists of counts */
    .db-list { list-style: none; margin: 0; padding: 0; font-size: 0.9375rem; }
    .db-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.35rem 0; border-bottom: 1px solid var(--border-subtle); }
    .db-list li:last-child { border-bottom: 0; }
    .db-list-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); column-gap: 1.5rem; }
    .db-list-2 li:last-child { border-bottom: 1px solid var(--border-subtle); }
    .db-list a { color: var(--mf-gold); }
    .db-list .db-n { font-weight: 700; white-space: nowrap; }
    .db-warn { color: var(--status-warning); }
    .db-pair { display: flex; align-items: baseline; gap: 0.6rem; }

    /* Detail dialog (one, filled per tile) */
    .db-dialog {
        width: min(48rem, 92vw);
        max-height: 88vh;
        padding: 1rem 1.25rem;
        background: var(--surface-panel);
        color: var(--text-primary);
        border: 1px solid var(--mf-gold);
        border-radius: 6px;
    }
    .db-dialog[open] { display: flex; flex-direction: column; }
    .db-dialog::backdrop { background: rgb(0 0 0 / 0.6); }
    .db-dialog h2 { margin: 0 0 0.6rem; font-size: 1.25rem; color: var(--mf-gold); }
    .db-dialog h3 { margin: 0.9rem 0 0.4rem; font-size: 1rem; color: var(--text-primary); }
    .db-dialog-body { position: relative; overflow-y: auto; min-height: 0; flex: 1; }
    .db-dialog-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.9rem; flex-wrap: wrap; }
    .db-view { display: flex; gap: 0.4rem 1.25rem; flex-wrap: wrap; margin: 0 0 0.6rem; padding: 0; border: 0; }
    .db-view legend { padding: 0; margin-bottom: 0.3rem; font-weight: 700; }
    .db-view label { display: flex; align-items: center; gap: 0.4rem; }
    .db-table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
    .db-table th, .db-table td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border-subtle); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
    .db-table th { color: var(--mf-gold); font-size: 0.875rem; }
    .db-table .db-n { text-align: right; white-space: nowrap; }
    .db-table td button { font-size: 0.875rem; padding: 0.2rem 0.6rem; min-block-size: 2rem; white-space: nowrap; }
    .db-sub { color: var(--text-muted); font-size: 0.875rem; }
    .db-field { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin: 0.2rem 0 0.4rem; }
    .db-field input { width: 4.5rem; }
</style>

<div class="mf-page-head">
    <h1 class="main" tabindex="-1">Dashboard</h1>
    <button type="button" class="mf-help-btn" data-mf-help="dashboard" data-mf-help-name="Dashboard">Help</button>
</div>

<div class="active_stage">
<div class="db-stage">
    <div class="db-bar">
        <p class="db-bar-status" id="db-status" role="status"></p>
        <button type="button" class="mf-button-gold-fixed db-btn-quiet" id="db-refresh">Refresh</button>
    </div>
    <div class="db-tiles" id="db-tiles" aria-label="Dashboard tiles" role="region"></div>
</div>
</div>

<!-- Detail of one tile (filled by dashboard.js) -->
<dialog id="db-detail" class="db-dialog" aria-labelledby="db-detail-h">
    <h2 id="db-detail-h"></h2>
    <div class="db-dialog-body" id="db-detail-body"></div>
    <form method="dialog" class="db-dialog-actions">
        <button type="submit" class="mf-button-gold-fixed">Close</button>
    </form>
</dialog>

<script>
    if (window.metaforge && window.metaforge.dashboard) {
        window.metaforge.dashboard.init();
    }
</script>
