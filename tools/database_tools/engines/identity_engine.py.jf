import json
from flask import jsonify, request
from common import db_engine, config_handler

def handle(action):
    if action == "get_taxonomy": return _get_taxonomy()
    if action == "search_artist": return _search_artist_logic(request.args.get('artist', ''))
    if action == "get_artist_details": return _get_artist_details_logic(request.args.get('mf_artist_id'))
    if action == "save_artist": return _save_artist()
    return jsonify({"status": "error", "message": "Action unknown"}), 404

def _get_artist_details_logic(aid):
    # 1. Fetch artist from library_artist
    rows = db_engine.execute_query("SELECT * FROM library_artist WHERE mf_artist_id = ?", (aid,))
    if not rows: return jsonify({"status": "error", "message": "Artist not found"}), 404
    
    artist = rows[0]
    artist['biography'] = artist.get('bio_text', "")
    
    # 2. Fetch albums: 
    # Union of albums where artist is primary (library_master) 
    # AND albums where artist appears in edges (contributing artist)
    query = """
        SELECT mf_id, album_title, 'Primary Artist' as role FROM library_master WHERE mf_artist_id = ?
        UNION
        SELECT source_id as mf_id, (SELECT album_title FROM library_master WHERE mf_id = edges.source_id) as album_title, role 
        FROM edges WHERE target_id = ? AND source_type = 'album'
    """
    
    albums_data = db_engine.execute_query(query, (aid, aid))
    
    # Deduplicate albums (in case artist is both primary and contributor)
    seen = set()
    unique_albums = []
    for album in albums_data:
        if album['mf_id'] not in seen:
            unique_albums.append(album)
            seen.add(album['mf_id'])

    artist['albums'] = unique_albums
    return jsonify({"status": "success", "type": "artist", "artist": artist})

def _save_artist():
    data = request.json
    # Strictly target 'bio_text' column
    db_engine.execute_query(
        "UPDATE library_artist SET artist_name = ?, country = ?, bio_text = ?, photo_path = ?, last_updated = CURRENT_TIMESTAMP WHERE mf_artist_id = ?",
        (data['name'], data['country'], data['biography'], data['photo_path'], data['mf_artist_id']),
        commit=True
    )
    return jsonify({"status": "success", "message": "Artist identity committed."})

def _search_artist_logic(query_str):
    res = db_engine.execute_query("SELECT * FROM library_artist WHERE artist_name LIKE ?", (f"%{query_str}%",))
    if not res: return jsonify({"status": "error", "message": "No artist found"})
    if len(res) > 1: return jsonify({"status": "multiple", "candidates": res})
    return jsonify({"status": "success", "artist": res[0]})

def _get_taxonomy():
    path = config_handler.DATA_DIR / "taxonomy.json"
    if path.exists():
        return jsonify({"status": "success", "taxonomy": json.loads(path.read_text(encoding='utf-8'))})
    return jsonify({"status": "error", "message": "Taxonomy missing"}), 404
