

<h1 class="main" tabindex="-1">Database Tools</h1>

<section class="database-description" aria-labelledby="database-info-label">
    <h2 id="unpack_convert-info-label" class="mf-grid-heading" style="display:none;">Tool Description</h2>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
		<p class="data-text tool_notes">While the AI furnished data generated by MetaForge Suite is quite accurate, there is no such thing as perfect. <br>Database Tools allow you to make edits to the mp3 tags and database entries generated by the suite, leaving the User in total control of the data stored.</p>
        <button class="mf-button-gold-fixed" 
                style="font-size:80%;margin-left:1.5rem; margin-right: 5rem;"
                onclick="metaforge.database.openHelp()" 
                aria-label="Open Databaase Tools help documentation">
            Help
        </button>
    </div>
</section>

<div id="mfi-content" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
<!-- h2 style="margin-bottom:10px; color:var(--mf-gold);">Select a tab to begin:</h2 -->
    <div class="sub-nav-container" style="margin-bottom: 10px; padding-left: 20px;">
        <button id="tab-artist" class="sub-nav-btn active" onclick="window.metaforge.database_tools.showPanel('artist', this)">Modify Artist</button>
        <button id="tab-album" class="sub-nav-btn" onclick="window.metaforge.database_tools.showPanel('album', this)">Modify Album</button>
		<button id="tab-fixer" class="sub-nav-btn" onclick="window.metaforge.database_tools.showPanel('fixer', this)">Database Purge</button>
    </div>

    <div id="workspace-stage" style="flex: 1; display: flex; flex-direction: column; background: var(--bg-main); overflow: hidden;">
    </div>
</div>

<style>
    #artist-album-grid::-webkit-scrollbar, #personnel-rows-container::-webkit-scrollbar { width: 6px; }
    #artist-album-grid::-webkit-scrollbar-thumb, #personnel-rows-container::-webkit-scrollbar-thumb { background: var(--mf-gold); border-radius: 3px; }
</style>

<div id="database-panel" class="mf-help-panel" role="dialog" aria-labelledby="database-title" style="display: none;">
    <div class="mf-panel-header">
        <h2 id="database-title">Help: Database Tools</h2>
        <button class="mf-panel-close" onclick="window.metaforge.database_tools.closeHelp()" aria-label="Close help panel">×</button>
    </div>
    <div id="upk-help-body" class="mf-panel-body"></div>
</div>

<script>
    // --- INITIALIZATION GATE ---
    // Brute-force ensures the UI automatically loads the "Modify Artist" search pane on initial startup
    (function() {
        const defaultTab = document.getElementById('tab-artist');
        if (defaultTab && window.metaforge && window.metaforge.database_tools) {
            window.metaforge.database_tools.showPanel('artist', defaultTab);
        } else {
            // Backup fallback if the framework namespace is still registering during DOM load
            document.addEventListener("DOMContentLoaded", function() {
                const retryTab = document.getElementById('tab-artist');
                if (retryTab && window.metaforge && window.metaforge.database_tools) {
                    window.metaforge.database_tools.showPanel('artist', retryTab);
                }
            });
        }
    })();
</script>