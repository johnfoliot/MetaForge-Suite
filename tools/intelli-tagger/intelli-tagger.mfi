<!-- --- START OF FILE intelli-tagger.mfi --- -->
<!-- ======================================================================
     MetaForge Interface: Intelli-Tagger (pipeline step 3 of 3)
     v2 (2026-11-13): per-tool pass. No inline styles; shared field and
     type tokens (1.x inline color:#000 made typed text black-on-black in
     the v2 dark theme); the form is a real <form> (Enter starts the run)
     and scrolls on its own with Begin Tagging pinned; MusicBrainz IDs sit
     in a disclosure (collapsed when they arrive filled in from step 2);
     native switch for database writing; native <dialog> for the Various
     Artists genre question; the run streams events (one entry per track,
     nothing truncated) and ends in the shared Next-step bar offering
     Album Personnel and Bio Builder.
     ====================================================================== -->
<style>
    .it-workbench-wrapper {
        display: flex;
        width: 100%;
        height: 100%;
        gap: 1rem;
        align-items: stretch;
    }

    /* --- LEFT: THE ALBUM. Scrolls on its own; Begin Tagging is pinned. --- */
    .it-input-silo {
        flex: 0 0 calc(32% - 0.5rem);
        display: flex;
        flex-direction: column;
        position: relative;   /* contains hidden screen-reader text */
        min-height: 0;
        overflow-y: auto;
        scroll-padding-bottom: 4.5rem;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
    }
    #it-form { flex: 1; display: flex; flex-direction: column; }
    #it-fieldset {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin: 0;
        padding: 0.75rem 0.9rem 0.9rem;
        border: 0;
        min-width: 0;
    }

    .it-field { display: flex; flex-direction: column; gap: 0.25rem; }
    .it-field > label {
        color: var(--mf-gold);
        font-size: 0.875rem;
        font-weight: 700;
    }
    .it-input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.4rem 0.5rem;
        font-family: var(--font-main);
        font-size: 1rem;
    }
    .it-input-mono { font-family: var(--font-mono); font-size: 0.875rem; }
    .it-path-row { display: flex; gap: 0.5rem; }
    .it-path-row .it-input { flex: 1; min-width: 0; }
    .it-path-row button { flex: none; }

    /* MusicBrainz IDs: a disclosure (COGA chunking). Collapsed when the IDs
       arrive filled in from step 2, open when any is missing. */
    .it-ids {
        border: 1px solid var(--border-subtle);
        background: var(--surface-raised);
    }
    .it-ids > summary {
        cursor: pointer;
        padding: 0.45rem 0.6rem;
        color: var(--mf-gold);
        font-size: 0.875rem;
        font-weight: 700;
    }
    .it-ids-body {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.2rem 0.6rem 0.7rem;
    }
    .it-ids-state { font-weight: 400; color: var(--text-muted); }
    #it-search-mb-btn[hidden] { display: none; }

    .it-switch-row {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: start;
        gap: 0.5rem;
    }
    .it-switch-row input {
        margin: 0.1rem 0 0;
        width: 2.25rem;
        height: 1.25rem;
        accent-color: var(--mf-gold);
        cursor: pointer;
    }
    .it-switch-row label {
        font-size: 0.9375rem;
        line-height: 1.4;
        color: var(--text-primary);
        cursor: pointer;
    }
    .it-hint {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.4;
        color: var(--text-muted);
    }

    .it-actions {
        position: sticky;
        bottom: 0;
        margin: auto -0.9rem -0.9rem;
        padding: 0.6rem 0.9rem;
        border-top: 1px solid var(--border-subtle);
        background: var(--surface-page);
        text-align: right;
    }

    /* --- RIGHT: PROGRESS, ACTIVITY LOG, NEXT STEPS --- */
    .it-output-silo {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        background: var(--surface-page);
        border: 3px solid var(--surface-raised);
        box-sizing: border-box;
        overflow: hidden;
    }
    .it-progress {
        flex-shrink: 0;
        padding: 0.6rem 0.9rem 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    #it-progress-container {
        height: 0.75rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-ui);
        border-radius: 3px;
        overflow: hidden;
    }
    .it-progress-fill { height: 100%; width: 0%; transition: width 0.3s ease; }
    #it-progress-label {
        margin: 0.4rem 0 0;
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--text-primary);
    }
    #it-console-outer { flex: 1; display: flex; min-height: 0; }
    .it-console {
        position: relative;   /* contains hidden "Error:"/"Warning:" labels */
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.75rem 0.9rem;
        color: var(--text-primary);
        line-height: 1.4;
    }
    .it-log-intro { margin: 0; font-size: 0.9375rem; color: var(--text-muted); }

    /* --- VARIOUS ARTISTS GENRE QUESTION (native modal <dialog>) --- */
    .it-genre-dialog {
        width: min(32rem, 90vw);
        padding: 1.1rem 1.25rem;
        background: var(--surface-panel);
        color: var(--text-primary);
        border: 1px solid var(--mf-gold);
        border-radius: 6px;
    }
    .it-genre-dialog::backdrop { background: rgb(0 0 0 / 0.6); }
    .it-genre-dialog h2 { margin: 0 0 0.5rem; color: var(--mf-gold); font-size: 1.125rem; }
    .it-genre-dialog p { margin: 0 0 0.75rem; font-size: 0.9375rem; line-height: 1.45; }
    .it-genre-dialog label { display: block; margin-bottom: 0.25rem; color: var(--mf-gold); font-size: 0.875rem; font-weight: 700; }
    .it-genre-dialog select { width: 100%; padding: 0.4rem 0.5rem; font-size: 1rem; margin-bottom: 1rem; }
    .it-dialog-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
</style>

<div class="mf-page-head">
    <h1 id="it-header" class="main" tabindex="-1">Intelli-Tagger</h1>
    <button type="button" class="mf-help-btn" data-mf-help="intelli-tagger" data-mf-help-name="Intelli-Tagger">Help</button>
</div>

<div class="active_stage">
<div class="it-workbench-wrapper">

    <!-- LEFT: THE ALBUM. Begin Tagging is the form's submit button, so
         Enter in any field starts the run once Artist and Album are filled. -->
    <div class="it-input-silo">
        <form id="it-form" novalidate>
            <fieldset id="it-fieldset">

                <div class="it-field">
                    <label for="it-path">Source Directory</label>
                    <div class="it-path-row">
                        <input type="text" id="it-path" class="it-input it-input-mono" readonly placeholder="Select album folder...">
                        <button type="button" id="it-browse-btn" class="mf-button-gold-fixed">Browse</button>
                    </div>
                </div>

                <div class="it-field">
                    <label for="it-artist">Filing Artist (Required)</label>
                    <input type="text" id="it-artist" class="it-input" placeholder="e.g. Pink Floyd" required>
                </div>

                <div class="it-field">
                    <label for="it-album">Album Title (Required)</label>
                    <input type="text" id="it-album" class="it-input" placeholder="e.g. The Wall" required>
                </div>

                <div class="it-field">
                    <label for="it-mb-country">Artist Native Country (Recommended)</label>
                    <input type="text" id="it-mb-country" class="it-input" placeholder="e.g. US, GB, XW">
                </div>

                <details class="it-ids" id="it-ids" open>
                    <summary>MusicBrainz IDs <span class="it-ids-state" id="it-ids-state">(Recommended)</span></summary>
                    <div class="it-ids-body">
                        <div class="it-field">
                            <label for="it-mb-artist-id">MusicBrainz Artist Id</label>
                            <input type="text" id="it-mb-artist-id" class="it-input it-input-mono">
                        </div>
                        <div class="it-field">
                            <label for="it-mb-album-id">MusicBrainz Album Id</label>
                            <input type="text" id="it-mb-album-id" class="it-input it-input-mono">
                        </div>
                        <div class="it-field">
                            <label for="it-mb-group-id">MusicBrainz Release Group Id</label>
                            <input type="text" id="it-mb-group-id" class="it-input it-input-mono">
                        </div>
                        <button type="button" id="it-search-mb-btn" class="mf-button-gold-fixed" hidden>Find them in MusicBrainz IDs (step 2)</button>
                    </div>
                </details>

                <div class="it-field">
                    <div class="it-switch-row">
                        <input type="checkbox" id="it-db-write" switch checked aria-describedby="it-db-hint">
                        <label for="it-db-write">Also write to the MetaForge database</label>
                    </div>
                    <p class="it-hint" id="it-db-hint">(The Library Viewer and Intelligent Playlist Maker read from the custom MetaForge database.)</p>
                </div>

                <div class="it-actions" style="background-color:var(--surface-raised);">
                    <button type="submit" id="it-start-btn" class="mf-button-gold-fixed" disabled>Begin Tagging</button>
                </div>

            </fieldset>
        </form>
    </div>

    <!-- RIGHT: PROGRESS, THE ACTIVITY LOG, THE NEXT STEPS -->
    <section class="it-output-silo" aria-label="Tagging progress and results">
        <div class="it-progress">
            <div id="it-progress-container" role="progressbar" aria-label="Intelli-Tagger progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="it-progress-fill" class="it-progress-fill mf-progress-shimmer"></div>
            </div>
            <p id="it-progress-label">Standing By</p>
        </div>

        <div id="it-console-outer">
            <!-- role="log" but NOT live: steps, problems and the finish are
                 spoken by the shared announcer (MFAnnounce). -->
            <div id="it-console" class="it-console mf-hide-native-scrollbar" role="log" aria-live="off" aria-label="Activity log" tabindex="0">
                <p class="it-log-intro">Choose the album folder to begin.</p>
            </div>
            <!-- Custom scrollbar, shared implementation (layout.css section 10 / MFScrollbar). -->
            <div class="mf-custom-scrollbar" aria-hidden=\"true\" aria-controls="it-console">
                <button type="button" class="mf-scroll-btn" aria-label="Scroll up" tabindex="-1">▲</button>
                <div class="mf-scroll-track">
                    <div class="mf-scroll-thumb"></div>
                </div>
                <button type="button" class="mf-scroll-btn" aria-label="Scroll down" tabindex="-1">▼</button>
            </div>
        </div>

        <!-- Next-step bar (shared .mf-handoff): only after a clean run with
             database writing on. Both steps are optional. -->
        <div class="mf-handoff" id="it-handoff" hidden>
            <p id="it-next-desc"><span class="mf-handoff-kicker">Optional next steps.</span> Album Personnel adds who played on each track (used by the Intelligent Playlist Maker). Bio Builder adds the artist's biography (used by the Library Viewer).</p>
            <div class="mf-handoff-actions">
                <button type="button" class="mf-button-gold-fixed" id="it-personnel-btn" aria-describedby="it-next-desc">Add Album Personnel</button>
                <button type="button" class="mf-button-gold-fixed" id="it-bio-btn" aria-describedby="it-next-desc">Build Artist Bio</button>
            </div>
        </div>
    </section>

</div>
</div>

<!-- Various Artists genre question: native modal <dialog> (Esc / Skip =
     let the AI decide; Enter or Confirm = use the chosen genre). -->
<dialog id="it-genre-dialog" class="it-genre-dialog" aria-labelledby="it-genre-title">
    <form method="dialog">
        <h2 id="it-genre-title">Confirm the album's genre</h2>
        <p>This album is filed under "Various Artists". The track artists are often obscure enough that the AI's genre guess drifts from track to track. Choose a parent genre to keep every track consistent, or let the AI decide per track.</p>
        <label for="it-genre-select">Parent genre</label>
        <select id="it-genre-select"></select>
        <div class="it-dialog-actions">
            <button type="submit" value="confirm" class="mf-button-gold-fixed">Confirm</button>
            <button type="submit" value="skip" class="mf-button-gold-fixed" formnovalidate>Skip: let the AI decide</button>
        </div>
    </form>
</dialog>

<script>
(function awakener() {
    if (window.metaforge?.intelli_tagger?.init) {
        window.metaforge.intelli_tagger.init();
    } else {
        setTimeout(awakener, 50);
    }
})();
</script>
<!-- --- END OF FILE intelli-tagger.mfi --- -->
